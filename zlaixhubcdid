local BuildStealerEngine = {
    CancelSpawn = false,
    ActiveSpawnCount = 0,
    LastSavedFile = "cdid_editable_builds",
    LastSavedBlockCount = 0,
    LastSavedPartCount = 0
}

do
local function getPlacementCatalogFolder()
    local po = ReplicatedStorage:FindFirstChild("PlacementObject")
    return po and po:FindFirstChild("Object")
end

local function getEditableBuildsFolder()
    local direct = Workspace:FindFirstChild("EditableBuilds")
    if direct then return direct end
    local etc = Workspace:FindFirstChild("Etc")
    return etc and etc:FindFirstChild("EditableBuilds")
end

local function isIgnoredBuildDescendant(inst)
    if not inst then return true end
    local n = inst.Name
    if n == "Hover" or n == "SelectionBox" or n == "Highlight" or n == "Owner" then
        return true
    end
    if inst:IsA("BillboardGui") or inst:IsA("ClickDetector") or inst:IsA("SelectionBox") or inst:IsA("Highlight") then
        return true
    end
    return false
end

local function isBuildableCDIDBlock(obj, catalogFolder)
    if not obj or not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    if isIgnoredBuildDescendant(obj) then return false end
    if LocalPlayer.Character and obj:IsDescendantOf(LocalPlayer.Character) then return false end
    local vehFolder = Workspace:FindFirstChild("Vehicles")
    if vehFolder and obj:IsDescendantOf(vehFolder) then return false end

    -- Must be either in PlacementObject.Object catalog or have CDID BuildTools attributes or be a valid block in EditableBuilds
    if catalogFolder and catalogFolder:FindFirstChild(obj.Name, true) then
        return true
    end
    if obj:GetAttribute("BT_Color") ~= nil or obj:GetAttribute("BT_Material") ~= nil
       or obj:GetAttribute("BT_Transparency") ~= nil or obj:GetAttribute("BT_Variant") ~= nil
       or obj:GetAttribute("BT_CanCollide") ~= nil then
        return true
    end
    if obj:FindFirstChild("Owner") then
        return true
    end
    -- Direct child inside EditableBuilds that has at least one BasePart
    if obj:IsA("BasePart") then return true end
    if obj:IsA("Model") and obj:FindFirstChildWhichIsA("BasePart", true) then return true end
    return false
end

local function serializePart(p, catalogName)
    local cf = p.CFrame
    local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()

    local data = {
        Class = p.ClassName,
        Name = p.Name,
        CatalogName = catalogName or p.Name,
        CF = { x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 },
        Size = { p.Size.X, p.Size.Y, p.Size.Z },
        Color = { p.Color.R, p.Color.G, p.Color.B },
        Material = p.Material.Name,
        Transparency = p.Transparency,
        Reflectance = p.Reflectance,
        CanCollide = p.CanCollide,
        CastShadow = p.CastShadow
    }

    if p:IsA("Part") then
        pcall(function() data.Shape = p.Shape.Name end)
    end

    if p:IsA("MeshPart") then
        pcall(function()
            data.MeshId = p.MeshId
            data.TextureID = p.TextureID
        end)
    else
        local sm = p:FindFirstChildOfClass("SpecialMesh")
        if sm then
            data.SpecialMesh = {
                MeshType = sm.MeshType.Name,
                MeshId = sm.MeshId,
                TextureId = sm.TextureId,
                Scale = { sm.Scale.X, sm.Scale.Y, sm.Scale.Z },
                Offset = { sm.Offset.X, sm.Offset.Y, sm.Offset.Z }
            }
        end
    end

    local decals = {}
    for _, child in ipairs(p:GetChildren()) do
        if child:IsA("Decal") or child:IsA("Texture") then
            table.insert(decals, {
                IsTexture = child:IsA("Texture"),
                Face = child.Face.Name,
                Texture = child.Texture,
                Transparency = child.Transparency,
                StudsPerTileU = child:IsA("Texture") and child.StudsPerTileU or nil,
                StudsPerTileV = child:IsA("Texture") and child.StudsPerTileV or nil
            })
        end
    end
    if #decals > 0 then
        data.Decals = decals
    end

    return data
end

local function serializeBuildableBlock(block)
    local pivotCF = block:GetPivot()
    local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = pivotCF:GetComponents()
    local primaryPart = block:IsA("BasePart") and block or (block.PrimaryPart or block:FindFirstChildWhichIsA("BasePart", true))

    local btColor = block:GetAttribute("BT_Color")
    local colorArr = nil
    if typeof(btColor) == "Color3" then
        colorArr = { btColor.R, btColor.G, btColor.B }
    elseif primaryPart then
        colorArr = { primaryPart.Color.R, primaryPart.Color.G, primaryPart.Color.B }
    end

    local btMat = block:GetAttribute("BT_Material")
    local matName = nil
    if typeof(btMat) == "EnumItem" then
        matName = btMat.Name
    elseif type(btMat) == "string" and btMat ~= "" then
        matName = btMat
    elseif primaryPart then
        matName = primaryPart.Material.Name
    end

    local btTrans = block:GetAttribute("BT_Transparency")
    if type(btTrans) ~= "number" and primaryPart then
        btTrans = primaryPart.Transparency
    end

    local btCollide = block:GetAttribute("BT_CanCollide")
    if type(btCollide) ~= "boolean" and primaryPart then
        btCollide = primaryPart.CanCollide
    end

    local btVariant = block:GetAttribute("BT_Variant")
    local scaleVal = nil
    local sizeArr = nil
    if block:IsA("Model") then
        pcall(function() scaleVal = block:GetScale() end)
    elseif block:IsA("BasePart") then
        sizeArr = { block.Size.X, block.Size.Y, block.Size.Z }
    end

    local ownerVal = block:FindFirstChild("Owner")
    local ownerName = (ownerVal and ownerVal:IsA("StringValue")) and ownerVal.Value or nil

    return {
        catalogName = block.Name,
        isModel = block:IsA("Model"),
        CF = { x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 },
        Scale = scaleVal,
        Size = sizeArr,
        Color = colorArr,
        Material = matName,
        Transparency = btTrans or 0,
        CanCollide = (btCollide == nil) and true or btCollide,
        Variant = btVariant,
        Owner = ownerName
    }
end

BuildStealerEngine.StealBuildableBlocks = function(fileName, ownerFilter)
    local cleanFile = (fileName and fileName ~= "") and fileName:gsub("[^%w_%-]", "") or (CustomBuildFileName and CustomBuildFileName ~= "" and CustomBuildFileName:gsub("[^%w_%-]", "")) or "cdid_editable_builds"
    local editable = getEditableBuildsFolder()
    local catalogFolder = getPlacementCatalogFolder()

    if not editable then
        showToast("Build & Steal", "Folder EditableBuilds tidak ditemukan di map ini.", 3.5, THEME.StatusAmber)
        return false, "Folder EditableBuilds tidak ditemukan", 0, 0
    end

    local blocksList = {}
    local partsList = {}
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge

    local children = editable:GetChildren()
    for idx, block in ipairs(children) do
        if isBuildableCDIDBlock(block, catalogFolder) then
            local passOwner = true
            if ownerFilter and ownerFilter ~= "" then
                local ow = block:FindFirstChild("Owner")
                local owTxt = (ow and ow:IsA("StringValue")) and ow.Value or ""
                if not owTxt:lower():find(ownerFilter:lower(), 1, true) then
                    passOwner = false
                end
            end

            if passOwner then
                local bEntry = serializeBuildableBlock(block)
                table.insert(blocksList, bEntry)

                if block:IsA("BasePart") then
                    local pData = serializePart(block, block.Name)
                    table.insert(partsList, pData)
                    local pos = block.Position
                    if pos.X < minX then minX = pos.X end
                    if pos.Y < minY then minY = pos.Y end
                    if pos.Z < minZ then minZ = pos.Z end
                    if pos.X > maxX then maxX = pos.X end
                    if pos.Y > maxY then maxY = pos.Y end
                    if pos.Z > maxZ then maxZ = pos.Z end
                else
                    for _, desc in ipairs(block:GetDescendants()) do
                        if desc:IsA("BasePart") and not isIgnoredBuildDescendant(desc) and not isIgnoredBuildDescendant(desc.Parent) then
                            local pData = serializePart(desc, block.Name)
                            table.insert(partsList, pData)
                            local pos = desc.Position
                            if pos.X < minX then minX = pos.X end
                            if pos.Y < minY then minY = pos.Y end
                            if pos.Z < minZ then minZ = pos.Z end
                            if pos.X > maxX then maxX = pos.X end
                            if pos.Y > maxY then maxY = pos.Y end
                            if pos.Z > maxZ then maxZ = pos.Z end
                        end
                    end
                end
            end
        end
        if idx % 500 == 0 then task.wait(0.01) end
    end

    if #blocksList == 0 and #partsList == 0 then
        showToast("Build & Steal", "Tidak ada block Build Tools yang ditemukan di EditableBuilds.", 3.5, THEME.StatusAmber)
        return false, "EditableBuilds kosong (0 block)", 0, 0
    end

    local originCF = { 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1 }
    if minX ~= math.huge then
        local ocf = CFrame.new((minX + maxX) / 2, minY, (minZ + maxZ) / 2)
        originCF = { ocf:GetComponents() }
    end

    local exportData = {
        Map = "CDID",
        Format = "CDID_BuildTools_v2",
        OnlyBuildableBlocks = true,
        PlaceId = game.PlaceId,
        Timestamp = os.date("%Y-%m-%d %H:%M:%S"),
        TotalBlocks = #blocksList,
        TotalParts = #partsList,
        OriginCF = originCF,
        Blocks = blocksList,
        Parts = partsList
    }

    local okEnc, jsonStr = pcall(function() return HttpService:JSONEncode(exportData) end)
    if not okEnc or not jsonStr then
        showToast("Build & Steal Error", "Gagal encode JSON data build.", 3.5, THEME.StatusRed)
        return false, "Gagal JSONEncode build", 0, 0
    end

    if writefile then
        writefile(cleanFile .. ".json", jsonStr)
        BuildStealerEngine.LastSavedFile = cleanFile
        BuildStealerEngine.LastSavedBlockCount = #blocksList
        BuildStealerEngine.LastSavedPartCount = #partsList
        BuildStealerEngine.CachedDetailedFiles = nil
        local msg = string.format("Tersimpan %d block (%d part) Build Tools ke %s.json (100%% Akurat)", #blocksList, #partsList, cleanFile)
        showToast("Steal Build Sukses!", msg, 4.5, THEME.AccentEmerald)
        return true, msg, #blocksList, #partsList
    else
        return false, "Executor tidak mendukung writefile", #blocksList, #partsList
    end
end

