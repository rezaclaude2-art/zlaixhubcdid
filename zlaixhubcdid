local function parseTsTableFromBlock(blockStr, keyName)
    local sub = blockStr:match(keyName .. "%s*=%s*(%b{})")
    if not sub then return nil end
    local y = tonumber(sub:match("year%s*=%s*(%d+)"))
    local m = tonumber(sub:match("month%s*=%s*(%d+)"))
    local d = tonumber(sub:match("day%s*=%s*(%d+)"))
    local hr = tonumber(sub:match("hour%s*=%s*(%d+)")) or 0
    local mn = tonumber(sub:match("min%s*=%s*(%d+)")) or 0
    local sc = tonumber(sub:match("sec%s*=%s*(%d+)")) or 0
    if y and m and d then
        return { year = y, month = m, day = d, hour = hr, min = mn, sec = sc }
    end
    return nil
end

local function getRealScheduledLimitedMap(forceRescan)
    if CDIDEngine.CachedDealershipSched and not forceRescan and (os.clock() - CDIDEngine.CachedDealershipSchedAt) < 120 then
        return CDIDEngine.CachedDealershipSched
    end
    local scheduledMap = {}

    -- 1. Optional runtime VM scan if executor exposes upvalues
    pcall(function()
        if getgc then
            for _, obj in ipairs(getgc(true)) do
                if type(obj) == "table" then
                    for k, v in pairs(obj) do
                        if type(k) == "string" and type(v) == "table" and type(v.start_ts) == "table" and type(v.end_ts) == "table" then
                            scheduledMap[k] = v
                        end
                    end
                end
            end
        end
    end)

    -- 2. Primary source on Xeno/all executors: decompile CDID's actual ClientContainer.UIAnimation.Dealership t9 table
    if next(scheduledMap) == nil and decompile then
        pcall(function()
            local cc = ReplicatedStorage:FindFirstChild("ClientContainer")
            local uiAnim = cc and cc:FindFirstChild("UIAnimation")
            local dMod = uiAnim and uiAnim:FindFirstChild("Dealership")
            if dMod and dMod:IsA("ModuleScript") then
                local src = decompile(dMod)
                if type(src) == "string" and src ~= "" then
                    for carId, block in src:gmatch('%["([^"]+)"%]%s*=%s*(%b{})') do
                        if block:find("start_ts") and block:find("end_ts") then
                            local st = parseTsTableFromBlock(block, "start_ts")
                            local et = parseTsTableFromBlock(block, "end_ts")
                            if st and et then
                                scheduledMap[carId] = {
                                    start_ts = st,
                                    end_ts = et,
                                    source = "Dealership.t9"
                                }
                            end
                        end
                    end
                end
            end
        end)
    end

    CDIDEngine.CachedDealershipSched = scheduledMap
    CDIDEngine.CachedDealershipSchedAt = os.clock()
    return scheduledMap
end

local function ensureLimitedHooks()
    if CDIDEngine.LimitedEventHooked then return end
    pcall(function()
        local net = ReplicatedStorage:FindFirstChild("NetworkContainer")
        local remEvents = net and net:FindFirstChild("RemoteEvents")
        local dealerEvent = remEvents and remEvents:FindFirstChild("Dealership")
        if dealerEvent and dealerEvent:IsA("RemoteEvent") then
            CDIDEngine.LimitedEventHooked = true
            registerConn(dealerEvent.OnClientEvent:Connect(function(action, carId, timeParam)
                if action == "Create" and carId then
                    local now = getServerTimeNow()
                    local numT = tonumber(timeParam)
                    local endU = (numT and numT > 1700000000) and numT
                        or (numT and numT > 0 and (now + numT))
                        or (now + 7200)
                    CDIDEngine.LivePublicLimiteds[tostring(carId)] = {
                        carId = tostring(carId),
                        startUnix = now,
                        endUnix = endU,
                        source = "DealershipEvent"
                    }
                    CDIDEngine.CachedLifecycleAt = 0
                    CDIDEngine.CachedCatalogAt = 0
                    _G.ZlaixForceCatalogPush = true
                    showToast("LIMITED BARU DI PUBLIC!", "Mobil Limited baru rilis di Dealership: " .. tostring(carId), 5.0, THEME.AccentEmerald)
                end
            end))
        end
        local newLimFolder = ReplicatedStorage:FindFirstChild("NEW_LIMITED_STOCK")
        if newLimFolder then
            local function checkFolderStockChild(ch)
                if ch:IsA("ValueBase") and (tonumber(ch.Value) or 0) > 0 then
                    local now = getServerTimeNow()
                    CDIDEngine.LivePublicLimiteds[ch.Name] = {
                        carId = ch.Name,
                        startUnix = now,
                        endUnix = 0,
                        source = "NEW_LIMITED_STOCK"
                    }
                    CDIDEngine.CachedLifecycleAt = 0
                    CDIDEngine.CachedCatalogAt = 0
                    _G.ZlaixForceCatalogPush = true
                end
            end
            registerConn(newLimFolder.ChildAdded:Connect(function(ch)
                checkFolderStockChild(ch)
                if ch:IsA("ValueBase") then
                    registerConn(ch.Changed:Connect(function()
                        CDIDEngine.CachedLifecycleAt = 0
                        CDIDEngine.CachedCatalogAt = 0
                        _G.ZlaixForceCatalogPush = true
                    end))
                end
            end))
        end
    end)
end
