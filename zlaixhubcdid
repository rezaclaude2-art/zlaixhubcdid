-- ====================================================================
-- 14. STARTUP NOTIFICATION & BIDIRECTIONAL WEB LOCALHOST BRIDGE
-- ====================================================================
showToast("Zlaix CDID Liquid Glass Siap!", "Toko Kotak, Upcoming Cars, Steal Build, Teleport & Auto Farm Aktif", 4.0, THEME.AccentEmerald)

local function startWebBridge()
    task.spawn(function()
        local fReq = request or http_request or syn_request or (http and http.request) or (syn and syn.request)
        if not fReq then return end

        local pendingResults = {}
        local sentCatalogHash = ""
        local tickCounter = 0

        local teleportLocationsPayload = {}
        for _, c in ipairs(CityOptions) do
            table.insert(teleportLocationsPayload, {
                name = c.Name,
                category = c.Category or "Area",
                pos = { math.floor(c.Pos.X), math.floor(c.Pos.Y), math.floor(c.Pos.Z) }
            })
        end

        while isScriptAlive() do
            task.wait(WebBridgeConnected and 1.5 or 3.5)
            if not WebBridgeEnabled then continue end
            tickCounter = tickCounter + 1

            pcall(function()
                local moneyVal = getNumericBalance()
                local worldTel = CDIDEngine.GetWorldTelemetry()
                local boxState = CDIDEngine.GetBoxShopState()
                local truckSpeed = 0
                local isDriver = false
                local curTruck = getMyTruck()
                if curTruck and curTruck.PrimaryPart then
                    truckSpeed = math.floor(curTruck.PrimaryPart.AssemblyLinearVelocity.Magnitude * 3.6)
                end
                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.SeatPart then isDriver = true end

                local ownedGpList = {}
                pcall(function()
                    local dr = getDataReplication()
                    if dr and type(dr.GetGamepass) == "function" then
                        local gpTbl = dr:GetGamepass()
                        if type(gpTbl) == "table" then
                            for k, v in pairs(gpTbl) do
                                if v == 1 or v == true then table.insert(ownedGpList, tostring(k)) end
                            end
                        end
                    end
                end)

                local bodyTbl = {
                    sessionId = SCRIPT_SESSION_ID,
                    player = {
                        name = LocalPlayer.Name,
                        displayName = LocalPlayer.DisplayName,
                        userId = LocalPlayer.UserId,
                        money = moneyVal,
                        moneyFormatted = formatRupiah(moneyVal),
                        ownedGamepasses = ownedGpList,
                        region = worldTel.region
                    },
                    world = worldTel,
                    boxState = boxState,
                    game = {
                        placeId = game.PlaceId,
                        jobId = game.JobId
                    },
                    truck = {
                        status = CurrentStatus or "Standby",
                        speed = truckSpeed,
                        driverSeat = isDriver and "Duduk (Supir)" or "Berdiri",
                        deliveries = TotalDeliveries or 0,
                        cargo = CurrentCargoName or "Menunggu Muatan...",
                        earnings = formatRupiah(TotalMoneyEarned or 0),
                        isSeated = isDriver,
                        truckName = (curTruck and curTruck.Name) or "Suzi Small Box"
                    },
                    stats = {
                        fps = math.floor(Workspace:GetRealPhysicsFPS() or 60),
                        uptimeSeconds = math.floor(os.clock() - FarmStartTime)
                    },
                    features = {
                        autoFarm = AutoFarmEnabled,
                        delaySeconds = DelaySeconds,
                        speedMultiplier = VehicleModsEngine.SpeedMultiplier,
                        cumiSmoke = VehicleModsEngine.CumiCumiEnabled
                    }
                }

                local resultsBatch = nil
                if #pendingResults > 0 then
                    resultsBatch = pendingResults
                    pendingResults = {}
                    bodyTbl.commandResults = resultsBatch
                end

                if _G.ZlaixForceCatalogPush or sentCatalogHash == "" then
                    local cat = CDIDEngine.ScanCatalog(_G.ZlaixForceCatalogPush == true)
                    bodyTbl.catalog = cat
                    bodyTbl.limitedStock = cat.limitedStock
                    bodyTbl.upcomingCars = cat.upcomingCars
                    bodyTbl.historyLimited = cat.historyLimited
                    bodyTbl.teleportLocations = teleportLocationsPayload
                    bodyTbl.buildFiles = BuildStealerEngine.GetDetailedBuildFiles()
                    sentCatalogHash = cat.catalogHash
                    _G.ZlaixForceCatalogPush = false
                elseif (tickCounter % 30 == 0) then
                    local lc = CDIDEngine.ScanLimitedLifecycle(false)
                    bodyTbl.limitedStock = lc.limitedStock
                    bodyTbl.upcomingCars = lc.upcomingCars
                    bodyTbl.historyLimited = lc.historyLimited
                end

                local encodedBody = HttpService:JSONEncode(bodyTbl)
                local t0 = os.clock()
                local res = fReq({
                    Url = WebServerUrl .. "/api/heartbeat",
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = encodedBody
                })
                local pingMs = math.floor((os.clock() - t0) * 1000)

                if res and res.StatusCode == 200 then
                    local data = HttpService:JSONDecode(res.Body)
                    WebBridgeConnected = true
                    WebPingMs = pingMs
                    if updateWebStatusUI then
                        updateWebStatusUI(true, data and data.serverUrl or WebServerUrl, pingMs)
                    end

                    if data and data.needsCatalog then
                        _G.ZlaixForceCatalogPush = true
                    end

                    if data and data.features and data.features.autoFarm ~= nil and data.features.autoFarm ~= AutoFarmEnabled then
                        AutoFarmEnabled = data.features.autoFarm
                        if autoFarmToggleCtrl then autoFarmToggleCtrl.updateState(AutoFarmEnabled, true) end
                        if AutoFarmEnabled then
                            FullscreenBlackout.Visible = true
                            MainWindow.Visible = false
                            setBlurState(false)
                            setFarmStatus("Memulai Auto Farm (Web Remote)...", 0)
                        else
                            FullscreenBlackout.Visible = false
                            MainWindow.Visible = true
                            setBlurState(true)
                            setFarmStatus("Standby (Auto Farm Mati)", 0)
                            JobStarted = false
                        end
                    end

                    if data and type(data.commands) == "table" and #data.commands > 0 then
                        for _, cmd in ipairs(data.commands) do
                            task.spawn(function()
                                local ok, msg, extraData = true, "Selesai", nil
                                local act = cmd.action
                                local pl = cmd.payload or {}
                                if act == "buy_car" then
                                    ok, msg = CDIDEngine.BuyCar(pl.dealerKey, pl.carId, pl.carName, {
                                        key = pl.colorKey,
                                        name = pl.colorName,
                                        rgb = pl.colorRgb,
                                        hex = pl.colorHex
                                    })
                                elseif act == "claim_box" then
                                    local stC
                                    ok, msg, stC = CDIDEngine.ClaimBox()
                                    extraData = { boxState = stC }
                                    _G.ZlaixForceCatalogPush = true
                                elseif act == "spin_box" then
                                    ok, msg, extraData = CDIDEngine.SpinBox(pl.boxKey or pl.boxName)
                                    _G.ZlaixForceCatalogPush = true
                                elseif act == "teleport_dealer" then
                                    ok, msg = CDIDEngine.TeleportToDealer(pl.dealerKey)
                                elseif act == "teleport_location" then
                                    ok, msg = CDIDEngine.TeleportToLocation(pl.locationName or pl.name)
                                elseif act == "steal_build" then
                                    local bCnt, pCnt
                                    ok, msg, bCnt, pCnt = BuildStealerEngine.StealBuildableBlocks(pl.fileName or "cdid_editable_builds", pl.ownerFilter)
                                    extraData = { blocks = bCnt, parts = pCnt, buildFiles = BuildStealerEngine.GetDetailedBuildFiles() }
                                    _G.ZlaixForceCatalogPush = true
                                elseif act == "spawn_build" then
                                    ok, msg = BuildStealerEngine.SpawnBuild(pl.fileName or "cdid_editable_builds", pl.spawnAtPlayer == true)
                                elseif act == "clear_build" then
                                    ok, msg = BuildStealerEngine.ClearLoaded()
                                elseif act == "refresh_catalog" then
                                    local cat = CDIDEngine.ScanCatalog(true)
                                    _G.ZlaixForceCatalogPush = true
                                    msg = string.format("Katalog diperbarui (%d dealer, %d Limited Stock, %d Upcoming, %d History)",
                                        #cat.dealers, #(cat.limitedStock or {}), #(cat.upcomingCars or {}), #(cat.historyLimited or {}))
                                elseif act == "redeem_code" then
                                    ok, msg, extraData = CDIDEngine.RedeemCode(pl.code)
                                elseif act == "ping" then
                                    msg = "Pong! @" .. LocalPlayer.Name .. " aktif (" .. tostring(pingMs) .. "ms)"
                                end
                                table.insert(pendingResults, {
                                    id = cmd.id,
                                    action = act,
                                    ok = ok,
                                    message = msg,
                                    data = extraData,
                                    timestamp = os.time() * 1000
                                })
                                showToast("Web Command", msg, 3.0, ok and THEME.AccentEmerald or THEME.StatusAmber)
                            end)
                        end
                    end
                else
                    if resultsBatch then
                        for _, r in ipairs(resultsBatch) do table.insert(pendingResults, r) end
                    end
                    WebBridgeConnected = false
                    if updateWebStatusUI then updateWebStatusUI(false) end
                end
            end)
        end
    end)
end
startWebBridge()
