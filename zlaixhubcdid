    local waypoints = etc and etc:FindFirstChild("Waypoint")
    local wp = waypoints and waypoints:FindFirstChild("Waypoint")
    if wp and wp:IsA("BasePart") then
        local bb = wp:FindFirstChildWhichIsA("BillboardGui", true)
        local tl = bb and bb:FindFirstChildWhichIsA("TextLabel", true)
        local destName = (tl and tl.Text ~= "") and tl.Text or "Cargo Destination"

        for _, area in pairs(OfficialTruckArea) do
            if destName:lower():find(area.txt:lower(), 1, true) or area.txt:lower():find(destName:lower(), 1, true) then
                return area.Location, wp, area.txt
            end
        end
        return wp.Position - Vector3.new(0, 20, 0), wp, destName
    end

    local truckJob = etc and etc:FindFirstChild("Job") and etc.Job:FindFirstChild("Truck")
    local destFolder = truckJob and truckJob:FindFirstChild("Destination")
    if destFolder then
        for _, ch in ipairs(destFolder:GetChildren()) do
            local part = ch:IsA("BasePart") and ch or (ch:FindFirstChild("Part") or ch:FindFirstChildWhichIsA("BasePart", true))
            if part and part.Transparency < 0.95 then
                return part.Position, part, "PT CDID Cargo"
            end
        end
    end

    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
