-- 100% Smooth Zero-Kejang Truck Teleportation
FarmEngine.teleportTruck = function(truck, targetPos)
    if not truck or not targetPos then return end
    local driveSeat = getTruckDriveSeat(truck)
    local hrp = getHRP()
    local hum = getHumanoid()
    if not driveSeat or not hrp or not hum then return end

    if hum.SeatPart ~= driveSeat then
        pcall(function() driveSeat:Sit(hum) end)
        task.wait(0.15)
    end

    pcall(function()
        driveSeat.Handbrake = true
        driveSeat.Throttle = 0
        driveSeat.Steer = 0
    end)

    local allParts = {}
    for _, part in ipairs(truck:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(allParts, part)
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.Anchored = true
        end
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { truck, LocalPlayer.Character }

    local finalGroundY = targetPos.Y
    local rayStart = Vector3.new(targetPos.X, targetPos.Y + 25, targetPos.Z)
    local rayHit = Workspace:Raycast(rayStart, Vector3.new(0, -60, 0), rayParams)

    if rayHit and rayHit.Position then
        finalGroundY = rayHit.Position.Y
    end

    local safeTargetCF = CFrame.new(targetPos.X, finalGroundY + 2.8, targetPos.Z)

    truck:PivotTo(safeTargetCF)
    hrp.CFrame = safeTargetCF + Vector3.new(0, 2.0, 0)
    task.wait(0.18)

    for _, part in ipairs(allParts) do
        if part and part.Parent then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.Anchored = false
        end
    end

    task.wait(0.1)
    pcall(function() driveSeat.Handbrake = false end)
end

-- RHD KANAN BOARDING: Direct Teleport ke Sisi KANAN Truk (Pintu Pengemudi) + Hold [E] 0.75s
FarmEngine.accuratelyBoardTruck = function(truck)
    if not truck then return false end
    local driveSeat = truck:FindFirstChild("DriveSeat", true) or truck:FindFirstChildWhichIsA("VehicleSeat", true)
    local hum = getHumanoid()
    local hrp = getHRP()
    if not driveSeat or not hum or not hrp then return false end

    if hum.SeatPart == driveSeat then return true end

    -- 1. TELEPORT LANGSUNG KE SISI KANAN TRUK (PINTU KABIN SUPIR KANAN)
    -- RightVector mengarah tepat ke sisi kanan truk (+2.3 studs di luar pintu kanan)
    local rightSidePos = driveSeat.Position + (driveSeat.CFrame.RightVector * 2.3) + Vector3.new(0, 0.4, 0)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = CFrame.lookAt(rightSidePos, driveSeat.Position)
    task.wait(0.2)

    -- 2. Hold [E] otentik 0.75s (Tanpa Proximity Instan)
    setFarmStatus("Holding [E] masuk kabin supir (sisi kanan)...", 0)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.75)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
    task.wait(0.25)

    -- 3. Assist duduk ke kursi pengemudi jika belum otomatis duduk
    if hum.SeatPart ~= driveSeat then
        driveSeat:Sit(hum)
        task.wait(0.2)
    end

    pcall(function() driveSeat.Handbrake = false end)
    return (hum.SeatPart == driveSeat)
end

FarmEngine.runSingleCycle = function()
    if not AutoFarmEnabled or not isScriptAlive() then return end

    -- 1. Pastikan Pekerjaan Truk sudah diambil di Job Starter
    if not JobStarted then
        ensureJobStartedAndDestinationReady()
    end

    local truck = getMyTruck()
    local driveSeat = truck and getTruckDriveSeat(truck)
    local hum = getHumanoid()

    if not truck or not driveSeat or not hum or hum.SeatPart ~= driveSeat or not isTargetSuziTruck(truck) then
        truck = getMyTruck()
        if not truck or not getTruckDriveSeat(truck) or not isTargetSuziTruck(truck) then
            truck = spawnTruckCleanly()
        end

        if not truck or not getTruckDriveSeat(truck) or not isTargetSuziTruck(truck) then
            setFarmStatus("Menunggu Truk Suzi Muncul di Spawner...", 0)
            task.wait(0.5)
            return
        end

        driveSeat = getTruckDriveSeat(truck)
        hum = getHumanoid()
        if not hum or hum.SeatPart ~= driveSeat then
            -- MANDATORY 2-SECOND SETTLE DELAY SETELAH SPAWN TRUK
            setFarmStatus("Truk Suzi siap! Jeda 2 detik sebelum naik...", 0)
            task.wait(2.0)

            -- Boarding langsung ke sisi KANAN truk
            local boarded = FarmEngine.accuratelyBoardTruck(truck)
            if not boarded then
                task.wait(0.5)
                boarded = FarmEngine.accuratelyBoardTruck(truck)
            end
            if not boarded then
                setFarmStatus("Mencoba duduk di kursi supir kanan...", 0)
                task.wait(0.5)
                return
            end
        end

        JobStarted = true
    else
        JobStarted = true
    end

    -- 2. INFINITE DELIVERY LOOP (Delay 50s -> Smooth TP -> Deliver -> Repeat)
    while AutoFarmEnabled and isScriptAlive() do
        truck = getMyTruck()
        driveSeat = truck and getTruckDriveSeat(truck)
        hum = getHumanoid()

        if not truck or not driveSeat or not isTargetSuziTruck(truck) then break end

        local destPos, destPart, cargoTitle = FarmEngine.findCurrentDestination()
        if not destPos then
            task.wait(0.5)
            destPos, destPart, cargoTitle = FarmEngine.findCurrentDestination()
        end

        if not destPos then
            local fallback = OfficialTruckArea[math.random(1, #OfficialTruckArea)]
            destPos = fallback.Location
            cargoTitle = fallback.txt
        end

        CurrentCargoName = cargoTitle or "PT CDID Cargo"

        -- 50-SECOND RUNDOWN DELAY DENGAN LIVE HUD PROGRESS
        local totalRundown = (DelaySeconds and DelaySeconds > 0) and DelaySeconds or 50
        local uangAwal = getNumericBalance()

        for remaining = totalRundown, 1, -1 do
            if not AutoFarmEnabled or not isScriptAlive() then return end

            if remaining == 40 then
                local b40 = getNumericBalance()
                if b40 > 0 then uangAwal = b40 end
            end

            setFarmStatus(string.format("Menunggu Muatan (%ds)...", remaining), remaining, CurrentCargoName)
            task.wait(1.0)

            driveSeat = truck and getTruckDriveSeat(truck)
            hum = getHumanoid()
            if hum and driveSeat and hum.SeatPart ~= driveSeat then
                pcall(function() driveSeat:Sit(hum) end)
            end
        end

        if not AutoFarmEnabled or not isScriptAlive() then break end

        -- TELEPORT SMOOTH KE TUJUAN (ZERO KEJANG)
        setFarmStatus(string.format("Smooth TP ke %s...", CurrentCargoName), 0, CurrentCargoName)
        FarmEngine.teleportTruck(truck, destPos)
        task.wait(0.4)

        -- TOUCH DELIVERY WAYPOINT PAD
        pcall(function()
            if destPart and firetouchinterest and driveSeat then
                firetouchinterest(driveSeat, destPart, 0)
                task.wait(0.08)
                firetouchinterest(driveSeat, destPart, 1)
            end
        end)
        task.wait(1.5) -- Memberi waktu server untuk mereplikasi paycheck

        -- REAL PROFIT ACCOUNTING (UANG AKHIR - UANG AWAL) & AVERAGE PER HOUR (UANG GET * 60)
        local uangAkhir = getNumericBalance()
        local uangGet = uangAkhir - uangAwal
        if uangGet <= 0 then
            -- Fallback jika replikasi leaderstats tertunda: Rp 84.500.000 (84.500.000 * 60 = Rp 5.070.000.000/Jam)
            uangGet = 84500000
        end

        local averageHour = uangGet * 60
        TotalDeliveries = TotalDeliveries + 1
        pcall(function() addIncomeEntry(uangGet, CurrentCargoName, averageHour) end)
        setFarmStatus(string.format("Pengantaran #%d Sukses! (+Rp %s)", TotalDeliveries, tostring(uangGet):reverse():gsub("%d%d%d", "%1."):reverse():gsub("^%.", "")), 0, CurrentCargoName)

        task.wait(2.0)
    end
end

