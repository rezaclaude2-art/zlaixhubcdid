local function attachInteractiveScale(btn, hoverScale, pressScale)
    local sc = Instance.new("UIScale", btn)
    sc.Scale = 1
    btn.MouseEnter:Connect(function()
        TweenService:Create(sc, TWEEN_FAST, { Scale = hoverScale or 1.02 }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(sc, TWEEN_FAST, { Scale = 1 }):Play()
    end)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(sc, TweenInfo.new(0.08, Enum.EasingStyle.Quad), { Scale = pressScale or 0.96 }):Play()
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(sc, TWEEN_SPRING, { Scale = 1 }):Play()
        end
    end)
end

local function applyGlassSurface(frame, radius, strokeTrans)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, radius or 14)
    local st = Instance.new("UIStroke", frame)
    st.Thickness = 1.15
    st.Color = THEME.CardBorder
    st.Transparency = strokeTrans or 0.72
    st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    local grad = Instance.new("UIGradient", frame)
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(34, 46, 68)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(14, 19, 30))
    })
    grad.Rotation = 135
    return st
end

local function switchTab(tabName)
    if activeTab == tabName then return end
    local oldPage = tabPages[activeTab]
    local newPage = tabPages[tabName]
    if oldPage then oldPage.Visible = false end
    if newPage then
        newPage.Visible = true
        newPage.CanvasPosition = Vector2.new(0, 0)
        newPage.Position = UDim2.new(0, 14, 0, 0)
        TweenService:Create(newPage, TWEEN_MED, { Position = UDim2.new(0, 0, 0, 0) }):Play()
    end
    if activeTab and tabButtons[activeTab] then
        local old = tabButtons[activeTab]
        TweenService:Create(old.btn, TWEEN_FAST, { BackgroundTransparency = 1, BackgroundColor3 = Color3.fromRGB(22, 30, 44) }):Play()
        TweenService:Create(old.stroke, TWEEN_FAST, { Transparency = 1 }):Play()
        old.txt.TextColor3 = THEME.TextSecondary
        old.txt.Font = Enum.Font.GothamMedium
        old.ico.ImageColor3 = THEME.SilverSecondary
    end
    activeTab = tabName
    if tabButtons[tabName] then
        local cur = tabButtons[tabName]
        TweenService:Create(cur.btn, TWEEN_MED, { BackgroundTransparency = 0.28, BackgroundColor3 = Color3.fromRGB(28, 44, 54) }):Play()
        TweenService:Create(cur.stroke, TWEEN_MED, { Transparency = 0.45 }):Play()
        cur.txt.TextColor3 = THEME.TextPrimary
        cur.txt.Font = Enum.Font.GothamBold
        cur.ico.ImageColor3 = THEME.AccentEmerald
    end
end

