            -- Evaluate 100% factual live state:
            if liveEvent and ((liveEvent.endUnix or 0) == 0 or serverNow < liveEvent.endUnix) then
                -- Active live event from Dealership.OnClientEvent("Create") or live NEW_LIMITED_STOCK > 0
                local remSec = (liveEvent.endUnix and liveEvent.endUnix > serverNow) and (liveEvent.endUnix - serverNow) or 0
                baseEntry.lifecycle = "LIMITED_STOCK"
                baseEntry.canBuy = true
                baseEntry.startUnix = browserNow
                baseEntry.endUnix = remSec > 0 and (browserNow + remSec) or 0
                baseEntry.remainingSec = remSec
                baseEntry.statusTag = "LIMITED STOCK (AKTIF DI PUBLIC)"
                baseEntry.rundownText = remSec > 0
                    and string.format("LIMITED AKTIF - Sisa Waktu: %s - Dealer: %s", formatHMS(remSec), baseEntry.dealerName)
                    or string.format("LIMITED AKTIF - Sisa Stock: %s - Dealer: %s", tostring(stockCount or "Tersedia"), baseEntry.dealerName)
                table.insert(limitedStockList, baseEntry)

            elseif guiLive then
                -- Physically visible inside PlayerGui.Dealership.Dealerlist right now!
                local remSec = guiLive.remainingSec or 0
                baseEntry.lifecycle = "LIMITED_STOCK"
                baseEntry.canBuy = true
                baseEntry.startUnix = browserNow
                baseEntry.endUnix = remSec > 0 and (browserNow + remSec) or 0
                baseEntry.remainingSec = remSec
                baseEntry.statusTag = "LIMITED STOCK (AKTIF DI PUBLIC)"
                baseEntry.rundownText = remSec > 0
                    and string.format("LIMITED AKTIF - Sisa Waktu: %s - Dealer: %s", formatHMS(remSec), baseEntry.dealerName)
                    or string.format("LIMITED AKTIF DI DEALERSHIP - Stock: %s - Dealer: %s", tostring(stockCount or "Inf"), baseEntry.dealerName)
                table.insert(limitedStockList, baseEntry)

            elseif startServerSec and endServerSec then
                if serverNow < startServerSec then
                    -- Genuine Upcoming scheduled in CDID t9 table!
                    local remToStart = startServerSec - serverNow
                    baseEntry.lifecycle = "UPCOMING"
                    baseEntry.canBuy = false
                    baseEntry.startUnix = browserNow + remToStart
                    baseEntry.endUnix = browserNow + (endServerSec - serverNow)
                    baseEntry.remainingSec = remToStart
                    baseEntry.statusTag = "UPCOMING LIMITED (TERJADWAL DI CDID)"
                    baseEntry.rundownText = string.format("Rilis dalam %s (%s) - Dealer: %s", formatHMS(remToStart), tostring(scheduleLabel or ""), baseEntry.dealerName)
                    table.insert(upcomingList, baseEntry)
                elseif serverNow < endServerSec then
                    -- Genuine Active Limited window in CDID t9 table!
                    local remToEnd = endServerSec - serverNow
                    baseEntry.lifecycle = "LIMITED_STOCK"
                    baseEntry.canBuy = true
                    baseEntry.startUnix = browserNow - (serverNow - startServerSec)
                    baseEntry.endUnix = browserNow + remToEnd
                    baseEntry.remainingSec = remToEnd
                    baseEntry.statusTag = "LIMITED STOCK (AKTIF DI PUBLIC)"
                    baseEntry.rundownText = string.format("LIMITED AKTIF - Sisa Waktu: %s - Dealer: %s", formatHMS(remToEnd), baseEntry.dealerName)
                    table.insert(limitedStockList, baseEntry)
                else
                    -- Genuine Expired t9 Limited -> History Limited!
                    baseEntry.lifecycle = "HISTORY_LIMITED"
                    baseEntry.canBuy = false
                    baseEntry.startUnix = browserNow - math.max(0, serverNow - startServerSec)
                    baseEntry.endUnix = browserNow - math.max(1, serverNow - endServerSec)
                    baseEntry.expiredServerSec = endServerSec
                    baseEntry.remainingSec = 0
                    baseEntry.statusTag = "WAKTU HABIS (HANGUS)"
                    baseEntry.rundownText = string.format("Waktu Habis (%s) - Eks Dealer: %s", tostring(scheduleLabel or "Off-Sale"), baseEntry.dealerName)
                    baseEntry.sortPriority = 1
                    table.insert(historyList, baseEntry)
                end

            elseif not hasUnobtainable and ((newStockNum and newStockNum > 0) or (oldStockNum and oldStockNum > 0) or (limitedSet[cId] == true)) then
                -- Factual obtainable stock limited right now in ReplicatedStorage without Unobtainable lock
                local remSec = sharedLimRemainingSec or 0
                baseEntry.lifecycle = "LIMITED_STOCK"
                baseEntry.canBuy = true
                baseEntry.startUnix = browserNow
                baseEntry.endUnix = remSec > 0 and (browserNow + remSec) or 0
                baseEntry.remainingSec = remSec
                baseEntry.statusTag = "LIMITED STOCK (AKTIF DI PUBLIC)"
                baseEntry.rundownText = string.format("LIMITED STOCK AKTIF (%s unit) - Dealer: %s", tostring(stockCount or "Inf"), baseEntry.dealerName)
                table.insert(limitedStockList, baseEntry)

            else
                -- Already Off-Sale / Unobtainable / 0 Stock -> HISTORY LIMITED (100% factual off-sale limiteds)
                baseEntry.lifecycle = "HISTORY_LIMITED"
                baseEntry.canBuy = false
                baseEntry.remainingSec = 0
                baseEntry.expiredServerSec = 0
                baseEntry.statusTag = "WAKTU HABIS (OFF-SALE)"
                baseEntry.rundownText = string.format("Off-Sale / Tidak Dijual Public - Eks Dealer: %s", baseEntry.dealerName)
                baseEntry.sortPriority = 2
                table.insert(historyList, baseEntry)
            end
        end
    end

    table.sort(limitedStockList, function(a, b)
        return (a.remainingSec or 999999) < (b.remainingSec or 999999)
    end)
    table.sort(upcomingList, function(a, b)
        return (a.remainingSec or 999999) < (b.remainingSec or 999999)
    end)
    table.sort(historyList, function(a, b)
        local ap = a.sortPriority or 9
        local bp = b.sortPriority or 9
        if ap ~= bp then return ap < bp end
        if (a.expiredServerSec or 0) ~= (b.expiredServerSec or 0) then
            return (a.expiredServerSec or 0) > (b.expiredServerSec or 0)
        end
        if (a.limitedOrder or 0) ~= (b.limitedOrder or 0) then
            return (a.limitedOrder or 0) > (b.limitedOrder or 0)
        end
        return (a.carDataOrder or 0) > (b.carDataOrder or 0)
    end)

    local resultObj = {
        limitedStock = limitedStockList,
        upcomingCars = upcomingList,
        historyLimited = historyList
    }
    CDIDEngine.CachedLifecycle = resultObj
    CDIDEngine.CachedLifecycleAt = os.clock()
    return resultObj
end

CDIDEngine.ScanUpcomingCars = function()
    local res = CDIDEngine.ScanLimitedLifecycle(false)
    return res.upcomingCars
end

