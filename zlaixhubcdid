local function pbRedeemKey(key, onStatus)
    local nonce = pbGenerateNonce()
    local endpoint = pbHost .. "/public/redeem/" .. fToString(pbService)
    local body = {
        identifier = lDigest(fGetHwid()),
        key = key
    }
    if pbUseNonce then body.nonce = nonce end

    local success, res = pcall(function()
        return fRequest({
            Url = endpoint,
            Method = "POST",
            Body = lEncode(body),
            Headers = { ["Content-Type"] = "application/json" }
        })
    end)

    if success and res and res.StatusCode == 200 then
        local decoded = lDecode(res.Body)
        if decoded and decoded.success == true and decoded.data and decoded.data.valid == true then
            return true
        else
            local msg = (decoded and decoded.message) or "Key Platoboost tidak valid."
            if onStatus then onStatus(msg) end
            return false
        end
    end
    return false
end

local function pbVerifyKey(key, onStatus)
    if pbRequestSending then
        if onStatus then onStatus("Pengecekan sedang berjalan...") end
        return false
    end
    pbRequestSending = true

    local valid = false
    local success, res = pcall(function()
        local nonce = pbGenerateNonce()
        local endpoint = pbHost .. "/public/whitelist/" .. fToString(pbService) .. "?identifier=" .. lDigest(fGetHwid()) .. "&key=" .. key
        if pbUseNonce then endpoint = endpoint .. "&nonce=" .. nonce end

        return fRequest({ Url = endpoint, Method = "GET" })
    end)

    pbRequestSending = false

    if success and res and res.StatusCode == 200 then
        local decoded = lDecode(res.Body)
        if decoded and decoded.success == true and decoded.data then
            if decoded.data.valid == true then
                valid = true
            else
                valid = pbRedeemKey(key, onStatus)
            end
        else
            local msg = (decoded and decoded.message) or "Key tidak valid."
            if onStatus then onStatus(msg) end
        end
    elseif success and res and res.StatusCode == 429 then
        if onStatus then onStatus("Rate limit Platoboost. Tunggu 20 detik.") end
    else
        valid = pbRedeemKey(key, onStatus)
    end

    return valid
end

