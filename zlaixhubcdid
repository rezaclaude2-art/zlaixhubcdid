CDIDEngine.GetBoxShopState = function()
    local nowUnix = getServerTimeNow()
    local guiRemaining = nil
    local guiMax = 5
    local guiClaimText = nil
    local guiPoints = nil
    local commonIconId = "12253815916"
    local dailyIconId = "12253815916"
    local miniIconId = "12253815916"

    pcall(function()
        local bc = resolveBoxGuiCache()
        if bc then
            if bc.lim and bc.lim:IsA("TextLabel") and bc.lim.Text ~= "" then
                local rNum, mNum = bc.lim.Text:match("(%d+)%s*/%s*(%d+)")
                if rNum and mNum then
                    guiRemaining = tonumber(rNum)
                    guiMax = tonumber(mNum) or 5
                end
            end
            if bc.claimLbl and bc.claimLbl:IsA("TextLabel") and bc.claimLbl.Text ~= "" then
                guiClaimText = bc.claimLbl.Text
            end
            if bc.mp and bc.mp:IsA("TextLabel") and bc.mp.Text ~= "" then
                local pNum = bc.mp.Text:match("(%d+)")
                if pNum then guiPoints = tonumber(pNum) end
            end
            commonIconId = bc.commonIconId or commonIconId
            dailyIconId = bc.dailyIconId or dailyIconId
            miniIconId = bc.miniIconId or miniIconId
        end
    end)

    local claimRemainingSec = 0
    local canClaim = true

    if guiClaimText then
        local h, m, s = guiClaimText:match("(%d+):(%d+):(%d+)")
        if h and m and s then
            local guiSec = tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s)
            if guiSec > 0 then
                claimRemainingSec = guiSec
                canClaim = false
                if CDIDEngine.LocalClaimUnix == 0 then
                    CDIDEngine.LocalClaimUnix = nowUnix - (86400 - guiSec)
                end
            end
        end
    end

    if CDIDEngine.LocalClaimUnix and CDIDEngine.LocalClaimUnix > 0 then
        local elapsed = os.time() - CDIDEngine.LocalClaimUnix
        if elapsed >= 0 and elapsed < 86400 then
            claimRemainingSec = 86400 - elapsed
            canClaim = false
        elseif elapsed >= 86400 then
            claimRemainingSec = 0
            canClaim = true
        end
    end

    local remaining = CDIDEngine.LocalBoxRemaining
    if remaining == nil then
        if guiRemaining ~= nil then
            if guiClaimText == "CLAIM HERE" and guiRemaining == 5 and (CDIDEngine.LocalClaimUnix == 0) then
                remaining = 0
            else
                remaining = guiRemaining
            end
        else
            remaining = canClaim and 0 or 5
        end
    elseif guiRemaining ~= nil and guiClaimText ~= "CLAIM HERE" then
        remaining = guiRemaining
        CDIDEngine.LocalBoxRemaining = remaining
    end

    local claimTimerText = canClaim and "Klaim di sini" or formatHMS(claimRemainingSec)
    local limitText = string.format("%d/%d Tersisa", remaining, guiMax)

    return {
        remaining = remaining,
        max = guiMax,
        canClaim = canClaim,
        claimRemainingSec = claimRemainingSec,
        claimTimerText = claimTimerText,
        lastClaimUnix = CDIDEngine.LocalClaimUnix or 0,
        minigamePoints = guiPoints or 0,
        limitText = limitText,
        requireClaimBeforeSpin = (remaining <= 0 and canClaim),
        waitTimerBeforeClaim = (remaining <= 0 and not canClaim),
        boxIcons = {
            limited = commonIconId ~= "" and commonIconId or "12253815916",
            gamepass = dailyIconId ~= "" and dailyIconId or "12253815916",
            minigame = miniIconId ~= "" and miniIconId or "12253815916"
        }
    }
end

CDIDEngine.ClaimBox = function()
    local curState = CDIDEngine.GetBoxShopState()
    if not curState.canClaim and curState.claimRemainingSec > 0 then
        local waitMsg = string.format("Belum bisa klaim! Harus menunggu timer 24 jam selesai (%s tersisa).", curState.claimTimerText)
        return false, waitMsg, curState
    end

    local net = ReplicatedStorage:FindFirstChild("NetworkContainer")
    local remEvents = net and net:FindFirstChild("RemoteEvents")
    local boxRem = remEvents and remEvents:FindFirstChild("Box")

    if boxRem and boxRem:IsA("RemoteEvent") then
        pcall(function()
            boxRem:FireServer("Claim")
        end)
    end

    pcall(function()
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        local bGui = pGui and pGui:FindFirstChild("BoxShop")
        local boxFrame = bGui and bGui:FindFirstChild("Box", true)
        if boxFrame then
