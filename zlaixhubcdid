    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 7

    local valLbl = Instance.new("TextLabel", card)
    valLbl.Size = UDim2.new(0, 50, 0, 20)
    valLbl.Position = UDim2.new(1, -64, 0, 8)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(defaultVal)
    valLbl.TextColor3 = THEME.AccentEmerald
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 12
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.ZIndex = 7

    local trackBg = Instance.new("Frame", card)
    trackBg.Size = UDim2.new(1, -28, 0, 6)
    trackBg.Position = UDim2.new(0, 14, 0, 42)
    trackBg.BackgroundColor3 = Color3.fromRGB(28, 36, 52)
    trackBg.BorderSizePixel = 0
    trackBg.ZIndex = 7
    Instance.new("UICorner", trackBg).CornerRadius = UDim.new(1, 0)

    local initRatio = math.clamp((defaultVal - minVal) / math.max(1, (maxVal - minVal)), 0, 1)
    local trackFill = Instance.new("Frame", trackBg)
    trackFill.Size = UDim2.new(initRatio, 0, 1, 0)
    trackFill.BackgroundColor3 = THEME.AccentEmerald
    trackFill.BorderSizePixel = 0
    trackFill.ZIndex = 8
    Instance.new("UICorner", trackFill).CornerRadius = UDim.new(1, 0)

    local handle = Instance.new("Frame", trackBg)
    handle.Size = UDim2.new(0, 14, 0, 14)
    handle.Position = UDim2.new(initRatio, -7, 0.5, -7)
    handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    handle.BorderSizePixel = 0
    handle.ZIndex = 9
    Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)

    local sliding = false
    local function updateFromPos(xPos)
        local width = trackBg.AbsoluteSize.X
        if width <= 1 then return end
        local relX = math.clamp(xPos - trackBg.AbsolutePosition.X, 0, width)
        local ratio = relX / width
        local val = math.floor(minVal + (ratio * (maxVal - minVal)) + 0.5)
        valLbl.Text = tostring(val)
        trackFill.Size = UDim2.new(ratio, 0, 1, 0)
        handle.Position = UDim2.new(ratio, -7, 0.5, -7)
        if callback then task.spawn(callback, val) end
    end

    local trackBtn = Instance.new("TextButton", trackBg)
    trackBtn.Size = UDim2.new(1, 0, 1, 18)
    trackBtn.Position = UDim2.new(0, 0, 0, -9)
    trackBtn.BackgroundTransparency = 1
    trackBtn.Text = ""
    trackBtn.ZIndex = 10

    trackBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            updateFromPos(input.Position.X)
            local moveConn, relConn
            moveConn = registerConn(UserInputService.InputChanged:Connect(function(mv)
                if sliding and (mv.UserInputType == Enum.UserInputType.MouseMovement or mv.UserInputType == Enum.UserInputType.Touch) then
                    updateFromPos(mv.Position.X)
                end
            end))
            relConn = registerConn(UserInputService.InputEnded:Connect(function(re)
                if re.UserInputType == Enum.UserInputType.MouseButton1 or re.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                    if moveConn then moveConn:Disconnect() end
                    if relConn then relConn:Disconnect() end
                end
            end))
        end
    end)

    return card
end

