local function resolveGroundY(targetPos, rayParams)
    local bestY = targetPos.Y
    for _ = 1, 10 do
        pcall(function() LocalPlayer:RequestStreamAroundAsync(targetPos) end)
        -- Cast from just above targetPos (+6 studs) so we hit the actual floor/road, never roofs/overpasses
        local hit = Workspace:Raycast(targetPos + Vector3.new(0, 6, 0), Vector3.new(0, -160, 0), rayParams)
        if hit and hit.Position and (hit.Position.Y - targetPos.Y) <= 8 then
            return hit.Position.Y
        end
        local hitMid = Workspace:Raycast(targetPos + Vector3.new(0, 14, 0), Vector3.new(0, -160, 0), rayParams)
        if hitMid and hitMid.Position and (hitMid.Position.Y - targetPos.Y) <= 10 then
            return hitMid.Position.Y
        end
        task.wait(0.06)
    end
    return bestY
end

local function safeMoveCharacter(targetPos)
    if not targetPos then return end
    if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end
    local char = LocalPlayer.Character
    local hrp = getHRP()
    local hum = getHumanoid()
    if not hrp or not char then return end

    -- If seated in a vehicle, teleport the vehicle smoothly with the character
    if hum and hum.SeatPart then
        local seatModel = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if seatModel and hum.SeatPart:IsA("VehicleSeat") then
            pcall(function() LocalPlayer:RequestStreamAroundAsync(targetPos) end)
            local allParts = {}
            for _, part in ipairs(seatModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    table.insert(allParts, part)
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                    part.Anchored = true
                end
            end
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = { seatModel, char }
            local groundY = resolveGroundY(targetPos, rayParams)
            local destCF = CFrame.new(targetPos.X, groundY + 3.0, targetPos.Z)
            seatModel:PivotTo(destCF)
            hrp.CFrame = destCF + Vector3.new(0, 2.0, 0)
            task.wait(0.12)
            for _, part in ipairs(allParts) do
                if part and part.Parent then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                    part.Anchored = false
                end
            end
            return
        else
            hum.Sit = false
            task.wait(0.15)
        end
    end

    hrp.Anchored = true
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3.0, 0))

    pcall(function() LocalPlayer:RequestStreamAroundAsync(targetPos) end)

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = { char }
    local vehFolder = Workspace:FindFirstChild("Vehicles")
    if vehFolder then table.insert(filterList, vehFolder) end
    rayParams.FilterDescendantsInstances = filterList

    local groundY = resolveGroundY(targetPos, rayParams)
    hrp.CFrame = CFrame.new(targetPos.X, groundY + 3.0, targetPos.Z)

    task.wait(0.12)
    if hrp and hrp.Parent then
        hrp.Anchored = false
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

