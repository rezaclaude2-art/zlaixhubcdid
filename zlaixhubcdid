    -- Event: Unified "Enter" Key Verification
    local isChecking = false
    local function executeKeyCheck()
        if isChecking then return end
        local inputStr = keyInput.Text
        if not inputStr or inputStr:gsub("%s+", "") == "" then
            statusLabel.TextColor3 = Color3.fromRGB(255, 100, 120)
            statusLabel.Text = "Masukkan key terlebih dahulu sebelum menekan Enter!"
            TweenService:Create(inputStroke, TweenInfo.new(0.2), { Color = Color3.fromRGB(255, 80, 100) }):Play()
            shakeModal()
            return
        end

        isChecking = true
        enterBtn.Text = "Memeriksa..."
        enterBtn.BackgroundColor3 = Color3.fromRGB(60, 70, 90)
        enterBtn.TextColor3 = Color3.fromRGB(220, 230, 245)
        statusLabel.TextColor3 = Color3.fromRGB(215, 225, 245)
        statusLabel.Text = "Memverifikasi key dengan Database Zlaix & Platoboost..."

        -- Safety watchdog timer (3.5 seconds) to prevent frozen button
        task.delay(3.5, function()
            if isChecking then
                isChecking = false
                if enterBtn.Parent then
                    enterBtn.Text = "Enter"
                    enterBtn.BackgroundColor3 = Color3.fromRGB(240, 245, 255)
                    enterBtn.TextColor3 = Color3.fromRGB(10, 12, 16)
                end
                if statusLabel.Parent and statusLabel.Text:find("Memverifikasi") then
                    statusLabel.Text = "Koneksi timeout. Silakan klik Enter kembali."
                    statusLabel.TextColor3 = Color3.fromRGB(255, 120, 140)
                end
            end
        end)

        task.spawn(function()
            local pcallOk, resultValid, resultTier, cleanKey = pcall(function()
                return checkKeyUniversal(inputStr, function(msg)
                    if statusLabel.Parent then statusLabel.Text = msg end
                end)
            end)

            if pcallOk and resultValid then
                -- STATE: KEY VALID
                saveValidKey(cleanKey)
                statusLabel.TextColor3 = Color3.fromRGB(245, 250, 255)
                statusLabel.Text = "Key Valid! [" .. tostring(resultTier) .. "] - Meluncurkan Zlaix Hub..."
                
                enterBtn.Text = "Valid!"
                enterBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                enterBtn.TextColor3 = Color3.fromRGB(10, 12, 16)
                
                protText.Text = "UNLOCKED"
                protText.TextColor3 = Color3.fromRGB(255, 255, 255)
                protPill.BackgroundColor3 = Color3.fromRGB(40, 50, 70)
                protStroke.Color = Color3.fromRGB(255, 255, 255)

                TweenService:Create(modalStroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(255, 255, 255), Thickness = 2 }):Play()
                TweenService:Create(inputStroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(255, 255, 255) }):Play()

                task.wait(0.55)

                -- Fluid exit animations
                TweenService:Create(blurEffect, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = 0 }):Play()
                TweenService:Create(notifBanner, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Position = UDim2.new(0.5, -205, 0, -90) }):Play()
                TweenService:Create(modalBox, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 0, 0, 0),
                    Position = UDim2.new(0.5, 0, 0.5, 0)
                }):Play()

                task.wait(0.5)
                pcall(function() blurEffect:Destroy() end)
                pcall(function() keyGui:Destroy() end)
                _G.ZlaixKeyValidated = true
            else
                -- STATE: KEY TIDAK VALID OR ERROR
                local errMsg = (pcallOk and resultTier) or "Key tidak cocok atau offline."
                statusLabel.TextColor3 = Color3.fromRGB(255, 100, 120)
                statusLabel.Text = "Key Tidak Valid! (" .. tostring(errMsg) .. ")"
                
                enterBtn.Text = "Enter"
                enterBtn.BackgroundColor3 = Color3.fromRGB(240, 245, 255)
                enterBtn.TextColor3 = Color3.fromRGB(10, 12, 16)
                isChecking = false

                TweenService:Create(modalStroke, TweenInfo.new(0.2), { Color = Color3.fromRGB(255, 80, 100), Thickness = 2 }):Play()
                TweenService:Create(inputStroke, TweenInfo.new(0.2), { Color = Color3.fromRGB(255, 80, 100) }):Play()
                shakeModal()

                task.wait(1.5)
                TweenService:Create(modalStroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(215, 225, 240), Thickness = 1.6 }):Play()
                TweenService:Create(inputStroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(75, 85, 105) }):Play()
            end
            isChecking = false
        end)
    end

    -- Connect both button click and physical keyboard Enter
    enterBtn.MouseButton1Click:Connect(executeKeyCheck)
    keyInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            executeKeyCheck()
        end
    end)

    -- Block thread until key is validated
    repeat task.wait(0.15) until _G.ZlaixKeyValidated == true
end
end


