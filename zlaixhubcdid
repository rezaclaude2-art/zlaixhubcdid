local function pbGenerateNonce()
    local str = ""
    for _ = 1, 16 do
        str = str .. fStringChar(fMathFloor(fMathRandom() * (122 - 97 + 1)) + 97)
    end
    return str
end

local function pbCacheLink(onStatus)
    if not fRequest then
        local msg = "Executor ini tidak mendukung HTTP Request."
        if onStatus then onStatus(msg) end
        return false, msg
    end
    if cachedTime + (10*60) < fOsTime() or cachedLink == "" then
        local success, res = pcall(function()
            return fRequest({
                Url = pbHost .. "/public/start",
                Method = "POST",
                Body = lEncode({
                    service = pbService,
                    identifier = lDigest(fGetHwid())
                }),
                Headers = { ["Content-Type"] = "application/json" }
            })
        end)

        if success and res and res.StatusCode == 200 then
            local decoded = lDecode(res.Body)
            if decoded and decoded.success == true and decoded.data and decoded.data.url then
                cachedLink = decoded.data.url
                cachedTime = fOsTime()
                return true, cachedLink
            else
                local msg = (decoded and decoded.message) or "Gagal membuat link Platoboost."
                if onStatus then onStatus(msg) end
                return false, msg
            end
        elseif success and res and res.StatusCode == 429 then
            local msg = "Rate limit Platoboost. Tunggu 20 detik."
            if onStatus then onStatus(msg) end
            return false, msg
        end
        local msg = "Gagal menghubungi server Platoboost."
        if onStatus then onStatus(msg) end
        return false, msg
    else
        return true, cachedLink
    end
end

