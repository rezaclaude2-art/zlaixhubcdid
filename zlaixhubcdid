getNumericBalance = function()
    local okCash, repCash = pcall(function()
        local dr = getDataReplication()
        if dr and type(dr.GetCash) == "function" then
            return dr:GetCash()
        end
    end)
    if okCash and tonumber(repCash) and tonumber(repCash) > 0 then
        return tonumber(repCash)
    end
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local mVal = leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Uang") or leaderstats:FindFirstChild("Rp")
        if mVal and tonumber(mVal.Value) then
            return tonumber(mVal.Value)
        end
    end
    local pgui = LocalPlayer:FindFirstChild("PlayerGui")
    if pgui then
        local dGui = pgui:FindFirstChild("Dealership")
        local cLbl = dGui and dGui:FindFirstChild("CashLabel", true)
        if cLbl and cLbl.Text ~= "" then
            local digits = cLbl.Text:gsub("[^%d]", "")
            if digits ~= "" and tonumber(digits) then return tonumber(digits) end
        end
        local bGui = pgui:FindFirstChild("BankInfo") or pgui:FindFirstChild("CashGui")
        if bGui then
            local cLabel = bGui:FindFirstChild("CashLabel", true)
            if cLabel and cLabel.Text ~= "" then
                local digits = cLabel.Text:gsub("[^%d]", "")
                if digits ~= "" and tonumber(digits) then return tonumber(digits) end
            end
        end
        local mainGui = pgui:FindFirstChild("Main")
        if mainGui then
            for _, desc in ipairs(mainGui:GetDescendants()) do
                if desc:IsA("TextLabel") and (desc.Text:find("RP") or desc.Text:find("Rp")) then
                    local digits = desc.Text:gsub("[^%d]", "")
                    if digits ~= "" and tonumber(digits) then return tonumber(digits) end
                end
            end
        end
    end
    return 0
end

