-- Helper to safely copy to clipboard across executor variants
local function safeSetClipboard(str)
    if not str or str == "" then return false end
    local copied = false
    pcall(function()
        if setclipboard then
            setclipboard(str)
            copied = true
        elseif toclipboard then
            toclipboard(str)
            copied = true
        elseif set_clipboard then
            set_clipboard(str)
            copied = true
        elseif Clipboard and Clipboard.set then
            Clipboard.set(str)
            copied = true
        end
    end)
    return copied
end

