                if callback then task.spawn(callback, curVal) end
            end)
        end
        selBtn.Text = (curVal ~= "" and curVal or "Pilih...") .. (expanded and "  ▴" or "  ▾")
    end

    selBtn.MouseButton1Click:Connect(function() toggleExpand() end)
    rebuildOptions(curOpts, curVal)

    return { card = card, setOptions = rebuildOptions, getValue = function() return curVal end }
end

