local cachedMyTruck = nil
local function getMyTruck()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
        local m = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if m then
            cachedMyTruck = m
            return m
        end
    end
    if cachedMyTruck and cachedMyTruck.Parent then
        return cachedMyTruck
    end
    local vehFolder = Workspace:FindFirstChild("Vehicles")
    if vehFolder then
        local myCar = vehFolder:FindFirstChild(LocalPlayer.Name .. "sCar")
        if myCar then
            cachedMyTruck = myCar
            return myCar
        end
    end
    local directCar = Workspace:FindFirstChild(LocalPlayer.Name .. "sCar")
    if directCar and directCar:IsA("Model") then
        cachedMyTruck = directCar
        return directCar
    end
    return nil
end

local function getTruckDriveSeat(veh)
    if not veh then return nil end
    local seat = veh:FindFirstChild("DriveSeat", true)
    if seat and seat:IsA("VehicleSeat") then return seat end
    return veh:FindFirstChildWhichIsA("VehicleSeat", true)
end

local function isTargetSuziTruck(v)
    if not v or not v.Parent then return false end
    if v.Name ~= LocalPlayer.Name .. "sCar" then return false end

    -- 1. Reject passenger personal cars
    local carData = v:FindFirstChild("CarData")
    local carNameVal = carData and carData:FindFirstChild("CarName")
    if carNameVal and carNameVal:IsA("StringValue") then
        local cn = carNameVal.Value:lower()
        if cn:find("avanza") or cn:find("innova") or cn:find("pajero") or cn:find("fortuner") 
           or cn:find("civic") or cn:find("brio") or cn:find("yaris") or cn:find("chiron") then
            return false
        end
    end

    -- 2. Reject Big Articulated Semi-Trailer Trucks (Quester + Trailer)
    if v:FindFirstChild("Trailer1") or v:FindFirstChild("Trailer") then
        return false
    end

    local body = v:FindFirstChild("Body")
    if body then
        for _, desc in ipairs(body:GetDescendants()) do
            local low = desc.Name:lower()
            if low:find("quester") or low:find("trailer") then
                return false
            end
        end
    end

    -- 3. Bounding box length check (Suzi Small Box Truck is <= 35 studs long)
    local _, sz = v:GetBoundingBox()
    if sz.Z > 35 then return false end

    -- 4. Must have a valid driver seat
    local driveSeat = v:FindFirstChild("DriveSeat", true) or v:FindFirstChildWhichIsA("VehicleSeat", true)
    if not driveSeat then return false end

    return true
end

