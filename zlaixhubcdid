local COLOR_LABELS_ID = {
    black  = "Hitam (Black)",
    white  = "Putih (White)",
    blue   = "Biru (Blue)",
    green  = "Hijau (Green)",
    orange = "Oranye (Orange)",
    pink   = "Pink (Merah Muda)",
    red    = "Merah (Red)",
    yellow = "Kuning (Yellow)",
    silver = "Silver (Abu)",
    grey   = "Abu-abu (Grey)",
    gray   = "Abu-abu (Gray)"
}

local function color3ToInfo(c3, keyName, displayName)
    if typeof(c3) ~= "Color3" then
        return {
            key = tostring(keyName or "White"),
            name = tostring(displayName or keyName or "Factory Color"),
            rgb = { 220, 228, 240 },
            hex = "#dce4f0"
        }
    end
    local r = math.clamp(math.floor(c3.R * 255 + 0.5), 0, 255)
    local g = math.clamp(math.floor(c3.G * 255 + 0.5), 0, 255)
    local b = math.clamp(math.floor(c3.B * 255 + 0.5), 0, 255)
    local hex = string.format("#%02x%02x%02x", r, g, b)
    local kStr = tostring(keyName or "")
    local label = displayName or COLOR_LABELS_ID[kStr:lower()] or (kStr ~= "" and kStr or nil)
    if not label or label == "" then
        if r < 35 and g < 35 and b < 35 then label = "Hitam (Black)"
        elseif r > 225 and g > 225 and b > 225 then label = "Putih (White)"
        elseif r > 180 and g < 70 and b < 70 then label = "Merah (Red)"
        elseif b > 170 and r < 80 then label = "Biru (Blue)"
        elseif g > 165 and r < 90 and b < 90 then label = "Hijau (Green)"
        elseif r > 210 and g > 180 and b < 80 then label = "Kuning (Yellow)"
        elseif math.abs(r - g) < 18 and math.abs(g - b) < 18 then label = "Silver / Abu"
        else label = string.format("Color (%d,%d,%d)", r, g, b) end
    end
    return {
        key = kStr ~= "" and kStr or label,
        name = label,
        rgb = { r, g, b },
        hex = hex
    }
end

local function getSharedTable(subPath)
    local ok, res = pcall(function()
        local cur = ReplicatedStorage:FindFirstChild("Shared")
        if not cur then return nil end
        for part in string.gmatch(subPath, "[^%.]+") do
            cur = cur:FindFirstChild(part)
            if not cur then return nil end
        end
        if cur:IsA("ModuleScript") then
            return require(cur)
        end
        return nil
    end)
    return ok and res or nil
end

