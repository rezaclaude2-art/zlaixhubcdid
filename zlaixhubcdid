CDIDEngine.GetWorldTelemetry = function()
    local ct = tonumber(Lighting.ClockTime) or 12
    local hours = math.floor(ct)
    local mins = math.floor((ct - hours) * 60 + 0.5) % 60
    local timeFormatted = string.format("%02d:%02d WIB", hours, mins)

    local period = "Malam (Night)"
    if ct >= 6 and ct <= 7.5 then
        period = "Pagi (Sunrise)"
    elseif ct > 7.5 and ct < 16.75 then
        period = "Siang (Noon)"
    elseif ct >= 16.75 and ct <= 18 then
        period = "Sore (Sunset)"
    end

    local isRaining = false
    pcall(function()
        local shared = ReplicatedStorage:FindFirstChild("Shared")
        local rainVal = shared and shared:FindFirstChild("Rain")
        if rainVal and rainVal:IsA("BoolValue") then
            isRaining = rainVal.Value == true
        end
    end)

    local weatherText = isRaining and "Hujan (Rain)" or "Cerah (Clear)"
    local placeName = "CDID"
    if game.PlaceId == 9233343468 then placeName = "Jawa Barat"
    elseif game.PlaceId == 9508940498 then placeName = "Jawa Tengah"
    elseif game.PlaceId == 14005966837 then placeName = "Jakarta"
    elseif game.PlaceId == 6911148748 then placeName = "Main Menu CDID" end

    return {
        clockTime = math.floor(ct * 100) / 100,
        timeFormatted = timeFormatted,
        timePeriod = period,
        weather = weatherText,
        isRaining = isRaining,
        region = placeName,
        placeId = game.PlaceId,
        serverTimeUnix = getServerTimeNow(),
        serverTimeWIB = os.date("%H:%M:%S WIB")
    }
end

CDIDEngine.ScanCatalog = function(forceRescan)
    if not forceRescan and CDIDEngine.Catalog and (os.clock() - (CDIDEngine.CachedCatalogAt or 0)) < 30 then
        return CDIDEngine.Catalog
    end
    scanRemotesAndModules()
    ensureGachaHook()

    local dealersMap = {}
    local boxesList = {}
    local ownedMap = getOwnedGamepassMap()
    local dealerPalette = getDealerGuiColors()
    local factoryOnlyPalette = {
        { key = "White", name = "Factory Color", rgb = { 220, 228, 240 }, hex = "#dce4f0", factoryOnly = true }
    }

    local blacklistDealers = makeLookupSet(getSharedTable("BlackListPaint.Dealer") or { "77", "Bandung", "Otnas", "Premium" })
    local blacklistCars    = makeLookupSet(getSharedTable("BlackListPaint.Car") or { "2011E92M3GTS" })
    local retroSet         = makeLookupSet(getSharedTable("RetroCar"))
    local luxurySet        = makeLookupSet(getSharedTable("LuxuryCar"))
    local emergencySet     = makeLookupSet(getSharedTable("EmergencyCar"))
    local rareImportSet    = makeLookupSet(getSharedTable("RareImportCar"))
    local limitedSet       = makeLookupSet(getSharedTable("LimitedCar"))
    local newCarSet        = makeLookupSet(getSharedTable("NewCar"))

    local dealerDisplayNames = {}
    for _, dOpt in ipairs(DealerOptions) do
        dealerDisplayNames[dOpt.Key] = dOpt.Name
    end

    local function ensureDealer(key)
        local cleanKey = tostring(key or "General")
        if not dealersMap[cleanKey] then
            local isFactoryOnly = blacklistDealers[cleanKey] == true
            dealersMap[cleanKey] = {
                key = cleanKey,
                name = dealerDisplayNames[cleanKey] or cleanKey,
                factoryOnly = isFactoryOnly,
                colors = isFactoryOnly and factoryOnlyPalette or dealerPalette,
                cars = {}
            }
        end
        return dealersMap[cleanKey]
    end

    local etc = Workspace:FindFirstChild("Etc")
    local dealershipsFolder = etc and etc:FindFirstChild("Dealership")
    if dealershipsFolder then
        for _, child in ipairs(dealershipsFolder:GetChildren()) do
            ensureDealer(child.Name)
        end
    end
    for _, dOpt in ipairs(DealerOptions) do
        ensureDealer(dOpt.Key)
    end

    local carDataFolder = ReplicatedStorage:FindFirstChild("CarData")
    local newLimitedStock = ReplicatedStorage:FindFirstChild("NEW_LIMITED_STOCK")
    local oldLimitedStock = ReplicatedStorage:FindFirstChild("LimitedStock")

    if carDataFolder then
        for _, car in ipairs(carDataFolder:GetChildren()) do
            local dealershipVal = car:FindFirstChild("Dealership")
            if dealershipVal and not car:FindFirstChild("Unobtainable") then
                local dKey = tostring(dealershipVal.Value)
                local dObj = ensureDealer(dKey)
                local carNameVal = car:FindFirstChild("CarName")
                local costVal    = car:FindFirstChild("Cost")
                local imgVal     = car:FindFirstChild("CarImage")
                local hpVal      = car:FindFirstChild("Horsepower")
                local bfVal      = car:FindFirstChild("BrakeForce")
                local engVal     = car:FindFirstChild("Engine")
                local seatVal    = car:FindFirstChild("Seater")

                local cPrice = costVal and tonumber(costVal.Value) or 0
                local cId    = car.Name
                local cName  = (carNameVal and tostring(carNameVal.Value)) or cId
                local cImgId = extractAssetId(imgVal and imgVal.Value or "")

                local gpKey = nil
                if retroSet[cId] then gpKey = "RetroCar"
                elseif luxurySet[cId] then gpKey = "LuxuryCar"
                elseif emergencySet[cId] then gpKey = "EmergencyCar"
                elseif rareImportSet[cId] then gpKey = "RareImportCar" end

                local stockCount = nil
                local stObj = (newLimitedStock and newLimitedStock:FindFirstChild(cId))
                    or (oldLimitedStock and oldLimitedStock:FindFirstChild(cId))
                if stObj and tonumber(stObj.Value) then
                    stockCount = tonumber(stObj.Value)
                end

                local isCarFactoryOnly = blacklistDealers[dKey] or blacklistCars[cId]
                table.insert(dObj.cars, {
                    id = cId,
                    name = cName,
                    price = cPrice,
                    priceFormatted = formatRupiah(cPrice),
                    imageId = cImgId,
                    gamepass = buildGamepassInfo(gpKey, ownedMap),
                    horsepower = hpVal and tonumber(hpVal.Value) or nil,
                    brakeforce = bfVal and tonumber(bfVal.Value) or nil,
                    engine = engVal and tostring(engVal.Value) or nil,
                    seats = seatVal and tostring(seatVal.Value) or nil,
                    isLimited = limitedSet[cId] == true,
                    isNew = newCarSet[cId] == true,
                    stock = stockCount,
                    factoryOnly = isCarFactoryOnly == true,
                    colors = isCarFactoryOnly and factoryOnlyPalette or dealerPalette
                })
            end
        end
    end

    local gachaMod = getSharedTable("Gacha")
    local function extractBoxRewards(boxName)
        local rewards = {}
        if gachaMod and type(gachaMod.GetItemsType) == "function" then
            local ok, groups = pcall(function() return gachaMod:GetItemsType(boxName) end)
            if ok and type(groups) == "table" then
                for _, grp in ipairs(groups) do
                    if type(grp) == "table" and type(grp.Items) == "table" then
                        for _, item in ipairs(grp.Items) do
                            table.insert(rewards, {
                                name = tostring(item.DisplayName or item.Name or "Reward"),
                                rarity = tostring(grp.Name or "Item"),
                                type = tostring(item.Type or "Item"),
                                imageId = extractAssetId(item.ImageId)
                            })
                        end
                    end
                end
            end
        end
        return rewards
    end

    local commonCost = (gachaMod and tonumber(gachaMod.CommonBoxPrice)) or 100000000
    local dailyCost  = (gachaMod and tonumber(gachaMod.DailyBoxPrice)) or 100000000
    local miniCost   = (gachaMod and tonumber(gachaMod.MinigameBoxPrice)) or 20
    local boxState   = CDIDEngine.GetBoxShopState()

    table.insert(boxesList, {
        key = "Limited Box",
        name = "Kotak Terbatas (Limited Box)",
        shortName = "Kotak Terbatas",
        costText = formatRupiah(commonCost),
        imageId = boxState.boxIcons.limited,
        webImage = "/box-limited.png",
        customFile = "box-limited.png",
        usesDailyLimit = true,
        rewards = extractBoxRewards("Limited Box")
    })
    table.insert(boxesList, {
        key = "Gamepass Box",
        name = "Kotak Gamepass (Gamepass Box)",
        shortName = "Kotak Gamepass",
        costText = formatRupiah(dailyCost),
        imageId = boxState.boxIcons.gamepass,
        webImage = "/box-gamepass.png",
        customFile = "box-gamepass.png",
        usesDailyLimit = true,
        rewards = extractBoxRewards("Gamepass Box")
    })
    table.insert(boxesList, {
        key = "Minigame Box",
        name = "Kotak Minigame (Minigame Box)",
        shortName = "Kotak Minigame",
        costText = tostring(miniCost) .. " POIN",
        imageId = boxState.boxIcons.minigame,
        webImage = "/box-minigame.png",
        customFile = "box-minigame.png",
        usesDailyLimit = false,
        rewards = extractBoxRewards("Minigame Box")
    })

    local dailyLimitText = string.format("%s - %s",
        boxState.limitText,
        boxState.canClaim and "Klaim di sini (Siap Reset Limit)" or ("Timer 24 Jam: " .. boxState.claimTimerText))

    local lifecycle = CDIDEngine.ScanLimitedLifecycle(forceRescan)
    local limitedStockCars = lifecycle.limitedStock or {}
    local upcomingCars = lifecycle.upcomingCars or {}
    local historyLimitedCars = lifecycle.historyLimited or {}

    -- Inject ONLY genuinely active Limited Stock cars into their respective Dealerships
    for _, limCar in ipairs(limitedStockCars) do
        local isTimedActive = ((limCar.endUnix or 0) > 0 and (limCar.remainingSec or 0) > 0) or ((limCar.endUnix or 0) == 0 and limCar.canBuy)
        if isTimedActive then
            local dKey = tostring(limCar.dealerKey or "Premium")
            local dObj = ensureDealer(dKey)
            local alreadyIn = false
            for _, existing in ipairs(dObj.cars) do
                if existing.id == limCar.id then
                    existing.isLimited = true
                    existing.endUnix = limCar.endUnix
                    existing.remainingSec = limCar.remainingSec
                    existing.rundownText = limCar.rundownText
                    alreadyIn = true
                    break
                end
            end
            if not alreadyIn then
                local isCarFactoryOnly = blacklistDealers[dKey] or blacklistCars[limCar.id]
                table.insert(dObj.cars, 1, {
                    id = limCar.id,
                    name = limCar.name,
                    price = limCar.price,
                    priceFormatted = limCar.priceFormatted,
                    imageId = limCar.imageId,
                    dealerKey = dKey,
                    dealerName = limCar.dealerName,
                    gamepass = limCar.gamepass,
                    horsepower = limCar.horsepower,
                    engine = limCar.engine,
                    seats = limCar.seats,
                    isLimited = true,
                    isNew = true,
                    stock = limCar.stock,
                    endUnix = limCar.endUnix,
                    remainingSec = limCar.remainingSec,
                    rundownText = limCar.rundownText,
                    factoryOnly = isCarFactoryOnly == true,
                    colors = isCarFactoryOnly and factoryOnlyPalette or dealerPalette
                })
            end
        end
    end

    local dealersArr = {}
    for _, d in pairs(dealersMap) do
        table.sort(d.cars, function(a, b)
            local aLim = a.isLimited and 0 or 1
            local bLim = b.isLimited and 0 or 1
            if aLim ~= bLim then return aLim < bLim end
            return (a.price or 0) < (b.price or 0)
        end)
        table.insert(dealersArr, d)
    end
    table.sort(dealersArr, function(a, b)
        local ac = #a.cars > 0 and 0 or 1
        local bc = #b.cars > 0 and 0 or 1
        if ac ~= bc then return ac < bc end
        return a.name < b.name
    end)

    CDIDEngine.Catalog = {
        dealers = dealersArr,
        boxes = boxesList,
        boxState = boxState,
        limitedStock = limitedStockCars,
        upcomingCars = upcomingCars,
        historyLimited = historyLimitedCars,
        dailyBoxLimit = dailyLimitText,
        catalogHash = tostring(#dealersArr) .. "_" .. tostring(#limitedStockCars) .. "_" .. tostring(#upcomingCars) .. "_" .. tostring(#historyLimitedCars) .. "_" .. tostring(os.time())
    }
    CDIDEngine.CachedCatalogAt = os.clock()
    return CDIDEngine.Catalog
end

CDIDEngine.TeleportToDealer = function(dealerKey)
    local keyStr = tostring(dealerKey or "")
    for _, dOpt in ipairs(DealerOptions) do
        if dOpt.Key:lower() == keyStr:lower() or dOpt.Name:lower() == keyStr:lower() then
            if dOpt.Pos then
                safeMoveCharacter(dOpt.Pos)
                return true, "Tiba di dealer " .. dOpt.Name
            end
        end
    end
    local etc = Workspace:FindFirstChild("Etc")
    local dealerships = etc and etc:FindFirstChild("Dealership")
    if dealerships then
        local dModel = dealerships:FindFirstChild(keyStr, true)
        if not dModel then
            for _, ch in ipairs(dealerships:GetChildren()) do
                if ch.Name:lower() == keyStr:lower() then
                    dModel = ch
                    break
                end
            end
        end
        if dModel then
            if dModel:IsA("PVInstance") then
                safeMoveCharacter(dModel:GetPivot().Position)
                return true, "Tiba di dealer " .. keyStr
            else
                local bp = dModel:FindFirstChildWhichIsA("BasePart", true)
                if bp then
                    safeMoveCharacter(bp.Position)
                    return true, "Tiba di dealer " .. keyStr
                end
            end
        end
    end
    return false, "Dealer tidak ditemukan di map: " .. keyStr
end

CDIDEngine.TeleportToLocation = function(locName)
    local q = tostring(locName or ""):lower()
    for _, c in ipairs(CityOptions) do
        if c.Name:lower() == q or c.Name:lower():find(q, 1, true) then
            safeMoveCharacter(c.Pos)
            return true, "Tiba di " .. c.Name
        end
    end
    for _, d in ipairs(DealerOptions) do
        if d.Name:lower() == q or d.Key:lower() == q then
            return CDIDEngine.TeleportToDealer(d.Key)
        end
    end
    return false, "Lokasi tidak ditemukan: " .. tostring(locName)
end

local function resolveColorKeyForDealer(dealerKey, carId, colorInfo)
    local blacklistDealers = makeLookupSet(getSharedTable("BlackListPaint.Dealer") or { "77", "Bandung", "Otnas", "Premium" })
    local blacklistCars    = makeLookupSet(getSharedTable("BlackListPaint.Car") or { "2011E92M3GTS" })
    if blacklistDealers[tostring(dealerKey)] or blacklistCars[tostring(carId)] then
        return "White", "Factory Color"
    end

    local palette = getDealerGuiColors()
    local reqKey  = colorInfo and tostring(colorInfo.key or "") or ""
    local reqName = colorInfo and tostring(colorInfo.name or "") or ""
    local lowReq  = (reqKey ~= "" and reqKey or reqName):lower()

    for _, c in ipairs(palette) do
        if c.key:lower() == lowReq or c.name:lower() == lowReq then
            return c.key, c.name
        end
    end
    if lowReq:find("hitam") or lowReq:find("black") then return "Black", "Hitam (Black)"
    elseif lowReq:find("putih") or lowReq:find("white") or lowReq:find("factory") then return "White", "Putih (White)"
    elseif lowReq:find("merah") or lowReq:find("red") then return "Red", "Merah (Red)"
    elseif lowReq:find("biru") or lowReq:find("blue") then return "Blue", "Biru (Blue)"
    elseif lowReq:find("hijau") or lowReq:find("green") then return "Green", "Hijau (Green)"
    elseif lowReq:find("kuning") or lowReq:find("yellow") then return "Yellow", "Kuning (Yellow)"
    elseif lowReq:find("oranye") or lowReq:find("orange") then return "Orange", "Oranye (Orange)"
    elseif lowReq:find("pink") then return "Pink", "Pink" end

    local first = palette[1]
    return first and first.key or "White", first and first.name or "White"
end

CDIDEngine.BuyCar = function(dealerKey, carId, carName, colorInfo)
    local net = ReplicatedStorage:FindFirstChild("NetworkContainer")
    local rFuncs = net and net:FindFirstChild("RemoteFunctions")
    local dealerRem = rFuncs and rFuncs:FindFirstChild("Dealership")
    if not dealerRem or not dealerRem:IsA("RemoteFunction") then
        return false, "Remote Dealership CDID tidak ditemukan di server ini."
    end

    local resolvedCarId = tostring(carId or "")
    local resolvedDealer = tostring(dealerKey or "")
    local displayCarName = tostring(carName or resolvedCarId)
    local carDataFolder = ReplicatedStorage:FindFirstChild("CarData")
    if carDataFolder then
        local found = carDataFolder:FindFirstChild(resolvedCarId)
        if not found and carName then
            for _, ch in ipairs(carDataFolder:GetChildren()) do
                local cn = ch:FindFirstChild("CarName")
                if cn and tostring(cn.Value):lower() == tostring(carName):lower() then
                    found = ch
                    break
                end
            end
        end
        if found then
            resolvedCarId = found.Name
            local cn = found:FindFirstChild("CarName")
            if cn then displayCarName = tostring(cn.Value) end
            local dv = found:FindFirstChild("Dealership")
            if dv and tostring(dv.Value) ~= "" then resolvedDealer = tostring(dv.Value) end
        end
    end

    if resolvedCarId == "" then
        return false, "Mobil tidak ditemukan di CarData."
    end

    local colorKey, colorLabel = resolveColorKeyForDealer(resolvedDealer, resolvedCarId, colorInfo)
    local okCall, serverRes = pcall(function()
        return dealerRem:InvokeServer("Buy", resolvedCarId, colorKey, resolvedDealer)
    end)

    if not okCall then
        return false, "Gagal invoke Dealership: " .. tostring(serverRes)
    end
    if serverRes == "Success" or serverRes == true then
        return true, string.format("Berhasil membeli %s (%s) di %s!", displayCarName, colorLabel, resolvedDealer)
    end
    return false, string.format("Gagal beli %s: %s", displayCarName, tostring(serverRes or "Ditolak server"))
end

CDIDEngine.SpinBox = function(boxKey)
    ensureGachaHook()
    local low = tostring(boxKey or "Limited"):lower()
    if low == "claim" or low:find("klaim") then
        local okC, msgC, stC = CDIDEngine.ClaimBox()
        return okC, msgC, { rewardName = "Klaim Box Reset 5/5", boxState = stC }
    end

    local targetBoxName = "Limited Box"
    local usesDailyLimit = true
    if low:find("gamepass") then
        targetBoxName = "Gamepass Box"
        usesDailyLimit = true
    elseif low:find("minigame") then
        targetBoxName = "Minigame Box"
        usesDailyLimit = false
    end

    local boxState = CDIDEngine.GetBoxShopState()
    if usesDailyLimit and boxState.remaining <= 0 then
        if boxState.canClaim then
            return false, "Limit Box 0/5 habis! Pencet tombol 'Klaim di sini' terlebih dahulu untuk me-reset limit menjadi 5/5.", {
                requireClaim = true,
                boxState = boxState
            }
        else
            return false, string.format("Limit Box 0/5 habis! Harus menunggu timer 24 jam selesai (%s tersisa) di Web / In-Game.", boxState.claimTimerText), {
                waitTimer = true,
                boxState = boxState
            }
        end
    end

    local net = ReplicatedStorage:FindFirstChild("NetworkContainer")
    local remEvents = net and net:FindFirstChild("RemoteEvents")
    local boxRem = remEvents and remEvents:FindFirstChild("Box")
    if not boxRem or not boxRem:IsA("RemoteEvent") then
        return false, "Remote Box Shop CDID tidak ditemukan.", { boxState = boxState }
    end

    local beforeSeq = CDIDEngine.LastGachaSeq
    local beforeMoney = getNumericBalance()

    local okFire, errFire = pcall(function()
        boxRem:FireServer("Buy", targetBoxName)
    end)
    if not okFire then
        return false, "Gagal kirim spin Box: " .. tostring(errFire), { boxState = boxState }
    end

    if usesDailyLimit then
        CDIDEngine.LocalBoxRemaining = math.max(0, (boxState.remaining or 5) - 1)
        savePersistedBoxState()
        pcall(function()
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            local bGui = pGui and pGui:FindFirstChild("BoxShop")
            local boxFrame = bGui and bGui:FindFirstChild("Box", true)
            local lim = boxFrame and boxFrame:FindFirstChild("Limit")
            if lim and lim:IsA("TextLabel") then
                lim.Text = string.format("%d/%d Tersisa", CDIDEngine.LocalBoxRemaining, boxState.max or 5)
            end
        end)
    end

    local t0 = os.clock()
    while os.clock() - t0 < 2.5 do
        if CDIDEngine.LastGachaSeq > beforeSeq and CDIDEngine.LastGachaResult then
            local gRes = CDIDEngine.LastGachaResult
            local afterMoney = getNumericBalance()
            local newSt = CDIDEngine.GetBoxShopState()
            return true, string.format("%s -> Dapat: %s (Sisa Limit: %d/%d)", targetBoxName, gRes.rewardName, newSt.remaining, newSt.max), {
                rewardName = gRes.rewardName,
                rewardType = gRes.rewardType,
                imageId = gRes.imageId,
                duplicate = gRes.duplicate,
                deltaMoney = afterMoney - beforeMoney,
                boxState = newSt
            }
        end
        task.wait(0.1)
    end

    local afterMoney = getNumericBalance()
    local newSt = CDIDEngine.GetBoxShopState()
    return true, string.format("Spin %s dikirim! Sisa Limit: %d/%d", targetBoxName, newSt.remaining, newSt.max), {
        rewardName = targetBoxName .. " Spin",
        deltaMoney = afterMoney - beforeMoney,
        boxState = newSt
    }
end

