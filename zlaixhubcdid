local KEY_FILE_NAME = "zlaix_key.txt"
local function getSavedKey()
    local k = ""
    pcall(function()
        if isfile and isfile(KEY_FILE_NAME) then
            k = readfile(KEY_FILE_NAME)
        elseif _G.ZlaixSavedKey then
            k = _G.ZlaixSavedKey
        end
    end)
    return k and k:match("^%s*(.-)%s*$") or ""
end

local function saveValidKey(k)
    pcall(function()
        _G.ZlaixSavedKey = k
        if writefile then
            writefile(KEY_FILE_NAME, k)
        end
    end)
end

