CDIDEngine.RedeemCode = function(rawCode)
    local code = tostring(rawCode or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if code == "" then
        return false, "Kode redeem tidak boleh kosong.", { code = code }
    end

    local net = ReplicatedStorage:FindFirstChild("NetworkContainer")
    local rFuncs = net and net:FindFirstChild("RemoteFunctions")
    local redeemRemote = rFuncs and rFuncs:FindFirstChild("Redeem")
    if not redeemRemote or not redeemRemote:IsA("RemoteFunction") then
        return false, "Remote Redeem CDID tidak ditemukan.", { code = code }
    end

    local ok, res = pcall(function()
        return redeemRemote:InvokeServer(code)
    end)
    if not ok then
        return false, "Gagal memanggil Redeem: " .. tostring(res), { code = code, rawResult = tostring(res) }
    end

    local resStr = tostring(res or "")
    local low = resStr:lower()
    local isErr = (low:find("invalid") or low:find("expired") or low:find("already") or low:find("used") or low:find("fail") or low:find("not found") or low:find("sudah")) ~= nil
    local msg = resStr ~= "" and (code .. ": " .. resStr) or (code .. ": Berhasil diredeem!")
    return (not isErr), msg, { code = code, rawResult = resStr }
end

