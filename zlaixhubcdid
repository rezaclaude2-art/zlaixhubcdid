BuildStealerEngine.GetAvailableBuildFiles = function()
    local files = {}
    local known = {
        "cdid_editable_builds",
        "build_CDID_Private_Build",
        "Bekasi_SDRP_Editable",
        "Bekasi_SDRP",
        "build_CDID_Full_Map",
        "cdid_full_map_deep"
    }
    local seen = {}

    if listfiles then
        local pSuccess, rawFiles = pcall(function() return listfiles("") end)
        if not pSuccess or not rawFiles then
            pSuccess, rawFiles = pcall(function() return listfiles(".") end)
        end
        if pSuccess and type(rawFiles) == "table" then
            for _, f in ipairs(rawFiles) do
                local s = tostring(f):gsub("^%./", ""):gsub("^/", "")
                if s:sub(1, 1) == string.char(92) then s = s:sub(2) end
                local lower = s:lower()
                if lower:match("%.json$") or lower:match("%.build$") then
                    local base = s:gsub("%.json$", ""):gsub("%.Build$", ""):gsub("%.build$", "")
                    if not lower:match("settings") and not lower:match("config") and not lower:match("whitelist")
                       and not lower:match("keysave") and not lower:match("inventory") and not lower:match("discovery")
                       and not lower:match("remotes") and not lower:match("update_log") and not lower:match("cache")
                       and not lower:match("builderhub_") and not lower:match("static_content") and not lower:match("userdata")
                       and not lower:match("zlaix_box_claim") then
                        if not seen[base] then
                            seen[base] = true
                            table.insert(files, base)
                        end
                    end
                end
            end
        end
    end

    for _, k in ipairs(known) do
        if not seen[k] and (not isfile or isfile(k .. ".json") or isfile(k .. ".build") or isfile(k)) then
            seen[k] = true
            table.insert(files, k)
        end
    end
    if #files == 0 then
        for _, k in ipairs(known) do
            if not seen[k] then
                seen[k] = true
                table.insert(files, k)
            end
        end
    end

    return files
end

BuildStealerEngine.GetDetailedBuildFiles = function(forceRefresh)
    if BuildStealerEngine.CachedDetailedFiles and not forceRefresh then
        return BuildStealerEngine.CachedDetailedFiles
    end
    local names = BuildStealerEngine.GetAvailableBuildFiles()
    local list = {}
    for _, name in ipairs(names) do
        local exists = false
        local sizeBytes = 0
        local filePath = name .. ".json"
        if isfile then
            if isfile(name .. ".json") then
                exists = true
                filePath = name .. ".json"
            elseif isfile(name .. ".build") then
                exists = true
                filePath = name .. ".build"
            elseif isfile(name) then
                exists = true
                filePath = name
            end
        end
        if exists and readfile and (forceRefresh or not BuildStealerEngine.CachedFileSizes) then
            BuildStealerEngine.CachedFileSizes = BuildStealerEngine.CachedFileSizes or {}
            if BuildStealerEngine.CachedFileSizes[filePath] ~= nil and not forceRefresh then
                sizeBytes = BuildStealerEngine.CachedFileSizes[filePath]
            else
                pcall(function()
                    local raw = readfile(filePath)
                    if raw then sizeBytes = #raw end
                end)
                BuildStealerEngine.CachedFileSizes[filePath] = sizeBytes
            end
        elseif BuildStealerEngine.CachedFileSizes and BuildStealerEngine.CachedFileSizes[filePath] then
            sizeBytes = BuildStealerEngine.CachedFileSizes[filePath]
        end
        table.insert(list, {
            name = name,
            fileName = filePath,
            exists = exists,
            sizeKB = math.floor((sizeBytes / 1024) * 10) / 10
        })
    end
    BuildStealerEngine.CachedDetailedFiles = list
    return list
end

BuildStealerEngine.SpawnBuild = function(fileName, spawnAtPlayer)
    if not readfile then
        showToast("Error Spawn", "Executor tidak mendukung readfile!", 3.5, THEME.StatusRed)
        return false, "Executor tidak mendukung readfile"
    end

    fileName = fileName or CustomBuildFileName or "cdid_editable_builds"
    BuildStealerEngine.CancelSpawn = false

    local filePath = fileName
    if isfile and not isfile(filePath) then
        if isfile(fileName .. ".json") then
            filePath = fileName .. ".json"
        elseif isfile(fileName .. ".build") then
            filePath = fileName .. ".build"
        elseif isfile(fileName .. ".Build") then
            filePath = fileName .. ".Build"
        end
    end

    local fileContent = nil
    local readSuccess = pcall(function()
        fileContent = readfile(filePath)
    end)

    if not readSuccess or not fileContent or fileContent == "" then
        showToast("File Tidak Ditemukan", "Gagal membaca: " .. tostring(filePath), 4.0, THEME.StatusRed)
        return false, "File tidak ditemukan: " .. tostring(filePath)
    end

    local parseSuccess, buildData = pcall(function()
        return HttpService:JSONDecode(fileContent)
    end)

    if not parseSuccess or not buildData then
        showToast("Data Korup", "Format JSON file build tidak valid", 4.0, THEME.StatusRed)
        return false, "Format JSON file build tidak valid"
    end

    local blocksList = type(buildData.Blocks) == "table" and buildData.Blocks or nil
    local partsList = type(buildData.Parts) == "table" and buildData.Parts or (type(buildData) == "table" and #buildData > 0 and buildData or nil)
    local catalogFolder = getPlacementCatalogFolder()

    if (not blocksList or #blocksList == 0) and (not partsList or #partsList == 0) then
        showToast("Build Kosong", "Tidak ada data block/part di dalam file ini", 3.5, THEME.StatusAmber)
        return false, "File build kosong"
    end

    task.spawn(function()
        local originCF = nil
        local playerBaseCF = nil

        if spawnAtPlayer then
            local hrp = getHRP()
            playerBaseCF = hrp and (hrp.CFrame * CFrame.new(0, 0, -18)) or CFrame.new(0, 50, 0)
            if type(buildData.OriginCF) == "table" and #buildData.OriginCF >= 12 then
                originCF = CFrame.new(unpack(buildData.OriginCF))
            else
                local srcList = (blocksList and #blocksList > 0) and blocksList or partsList
                local minX, minY, minZ = math.huge, math.huge, math.huge
                local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
                for i = 1, math.min(#srcList, 600) do
                    local item = srcList[i]
                    if item and item.CF and #item.CF >= 3 then
                        local px, py, pz = item.CF[1], item.CF[2], item.CF[3]
                        if px < minX then minX = px end
                        if py < minY then minY = py end
                        if pz < minZ then minZ = pz end
                        if px > maxX then maxX = px end
                        if py > maxY then maxY = py end
                        if pz > maxZ then maxZ = pz end
                    end
                end
                if minX ~= math.huge then
                    originCF = CFrame.new((minX + maxX) / 2, minY, (minZ + maxZ) / 2)
                else
                    originCF = CFrame.new(0, 0, 0)
                end
            end
        end

        local rootFolder = Workspace:FindFirstChild("ZlaixSpawnedBuild")
        if not rootFolder then
            rootFolder = Instance.new("Folder")
            rootFolder.Name = "ZlaixSpawnedBuild"
            rootFolder.Parent = Workspace
        end

        local cleanName = tostring(fileName):gsub("[^%w_%-]", "")
        local buildFolder = Instance.new("Folder")
        buildFolder.Name = cleanName .. "_" .. os.time()
        buildFolder.Parent = rootFolder

        local spawnedCount = 0

        -- Priority 1: Reconstruct directly from CDID PlacementObject.Object templates if Blocks array is available
        if blocksList and #blocksList > 0 and catalogFolder then
            local totalBlocks = #blocksList
            showToast("Memulai Spawn Build Tools", string.format("Memuat %d block CDID dari %s...", totalBlocks, fileName), 3.0, THEME.AccentEmerald)
            local fallbackBlocks = {}

            for i = 1, totalBlocks do
                if BuildStealerEngine.CancelSpawn then
                    showToast("Dibatalkan", "Proses spawn build dihentikan", 3.0, THEME.StatusAmber)
                    return
                end
                local bData = blocksList[i]
                local template = bData and bData.catalogName and catalogFolder:FindFirstChild(bData.catalogName, true)
                if template and (template:IsA("Model") or template:IsA("BasePart")) and bData.CF and #bData.CF >= 12 then
                    local clone = template:Clone()
                    for _, desc in ipairs(clone:GetDescendants()) do
                        if isIgnoredBuildDescendant(desc) then
                            pcall(function() desc:Destroy() end)
                        end
                    end

                    local rawCF = CFrame.new(unpack(bData.CF))
                    local targetCF = (spawnAtPlayer and originCF and playerBaseCF) and playerBaseCF:ToWorldSpace(originCF:ToObjectSpace(rawCF)) or rawCF

                    if clone:IsA("Model") and bData.Scale and type(bData.Scale) == "number" then
                        pcall(function() clone:ScaleTo(bData.Scale) end)
                    elseif clone:IsA("BasePart") and bData.Size and #bData.Size == 3 then
                        clone.Size = Vector3.new(unpack(bData.Size))
                    end

                    local col = nil
                    if bData.Color and #bData.Color >= 3 then
                        local r, g, b = bData.Color[1], bData.Color[2], bData.Color[3]
                        col = ((r > 1 or g > 1 or b > 1) and Color3.fromRGB(r, g, b)) or Color3.new(r, g, b)
                    end
                    local mat = bData.Material and Enum.Material[bData.Material] or nil
                    local trans = tonumber(bData.Transparency)
                    local canCol = bData.CanCollide

                    local function applyPartProps(pt)
                        pt.Anchored = true
                        if col then pt.Color = col end
                        if mat then pt.Material = mat end
                        if trans ~= nil then pt.Transparency = trans end
                        if canCol ~= nil then pt.CanCollide = canCol end
                    end

                    if clone:IsA("BasePart") then
                        applyPartProps(clone)
                        clone.CFrame = targetCF
                    else
                        for _, desc in ipairs(clone:GetDescendants()) do
                            if desc:IsA("BasePart") then applyPartProps(desc) end
                        end
                        clone:PivotTo(targetCF)
                    end

                    clone.Parent = buildFolder
                    spawnedCount = spawnedCount + 1
                else
                    fallbackBlocks[i] = true
                end

                if i % 150 == 0 then task.wait(0.01) end
            end

            if spawnedCount > 0 then
                BuildStealerEngine.ActiveSpawnCount = spawnedCount
                showToast("Spawn Build Sukses!", string.format("Berhasil spawn %d block CDID dari %s (100%% Akurat)", spawnedCount, fileName), 4.5, THEME.AccentEmerald)
                return
            end
        end

        -- Priority 2: Universal Part-Level Precision Reconstruction
        if not partsList or #partsList == 0 then return end
        local totalParts = #partsList
        showToast("Memulai Spawn", string.format("Memuat %d parts dari %s...", totalParts, fileName), 3.0, THEME.AccentEmerald)

        for i = 1, totalParts do
            if BuildStealerEngine.CancelSpawn then
                showToast("Dibatalkan", "Proses spawn build dihentikan", 3.0, THEME.StatusAmber)
                break
            end

            local pData = partsList[i]
            if pData and (pData.CF or pData.Size) and not isIgnoredBuildDescendant({ Name = pData.Name or "", IsA = function() return false end }) then
                local partClass = pData.Class or "Part"
                local p = nil

                if partClass == "WedgePart" then
                    p = Instance.new("WedgePart")
                elseif partClass == "CornerWedgePart" then
                    p = Instance.new("CornerWedgePart")
                elseif partClass == "TrussPart" then
                    p = Instance.new("TrussPart")
                else
                    p = Instance.new("Part")
                    if pData.Shape then
                        pcall(function()
                            p.Shape = Enum.PartType[pData.Shape] or Enum.PartType.Block
                        end)
                    end
                end

                p.Name = pData.Name or "Part"

                local cfData = pData.CF
                if cfData and #cfData >= 12 then
                    local rawCF = CFrame.new(unpack(cfData))
                    if spawnAtPlayer and originCF and playerBaseCF then
                        local relCF = originCF:ToObjectSpace(rawCF)
                        p.CFrame = playerBaseCF:ToWorldSpace(relCF)
                    else
                        p.CFrame = rawCF
                    end
                elseif cfData and #cfData == 3 then
                    p.Position = Vector3.new(unpack(cfData))
                end

                if pData.Size then
                    p.Size = Vector3.new(unpack(pData.Size))
                end

                if pData.Color then
                    local r, g, b = pData.Color[1], pData.Color[2], pData.Color[3]
                    if (r and r > 1) or (g and g > 1) or (b and b > 1) then
                        p.Color = Color3.fromRGB(r, g, b)
                    else
                        p.Color = Color3.new(r or 1, g or 1, b or 1)
                    end
                end

                if pData.Material then
                    p.Material = Enum.Material[pData.Material] or Enum.Material.Plastic
                end

                p.Transparency = pData.Transparency or 0
                p.Reflectance = pData.Reflectance or 0
                p.CanCollide = (pData.CanCollide == nil) and true or pData.CanCollide
                p.CastShadow = (pData.CastShadow ~= false)
                p.Anchored = true

                if pData.MeshId or pData.Class == "MeshPart" or pData.SpecialMesh then
                    local sm = Instance.new("SpecialMesh")
                    if pData.SpecialMesh then
                        local smData = pData.SpecialMesh
                        pcall(function()
                            sm.MeshType = Enum.MeshType[smData.MeshType] or Enum.MeshType.FileMesh
                        end)
                        sm.MeshId = smData.MeshId or ""
                        sm.TextureId = smData.TextureId or ""
                        if smData.Scale then sm.Scale = Vector3.new(unpack(smData.Scale)) end
                        if smData.Offset then sm.Offset = Vector3.new(unpack(smData.Offset)) end
                    else
                        sm.MeshType = Enum.MeshType.FileMesh
                        sm.MeshId = pData.MeshId or ""
                        sm.TextureId = pData.TextureID or ""
                    end
                    sm.Parent = p
                end

                if pData.Decals and type(pData.Decals) == "table" then
                    for _, dec in ipairs(pData.Decals) do
                        local d = Instance.new(dec.IsTexture and "Texture" or "Decal")
                        d.Face = Enum.NormalId[dec.Face] or Enum.NormalId.Front
                        d.Texture = dec.Texture or ""
                        d.Transparency = dec.Transparency or 0
                        if dec.IsTexture then
                            if dec.StudsPerTileU then d.StudsPerTileU = dec.StudsPerTileU end
                            if dec.StudsPerTileV then d.StudsPerTileV = dec.StudsPerTileV end
                        end
                        d.Parent = p
                    end
                end

                p.Parent = buildFolder
                spawnedCount = spawnedCount + 1
            end

            if i % 200 == 0 then
                task.wait(0.01)
            end
        end

        BuildStealerEngine.ActiveSpawnCount = spawnedCount
        showToast("Spawn Sukses!", string.format("Berhasil spawn %d parts dari %s", spawnedCount, fileName), 4.5, THEME.AccentEmerald)
    end)
    return true, "Memulai spawn " .. tostring(fileName)
end

