local function formatHMS(sec)
    sec = math.max(0, math.floor(tonumber(sec) or 0))
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function refreshServerTimeOffset(forceSync)
    local nowClock = os.clock()
    if CDIDEngine.ServerTimeSynced and not forceSync and (nowClock - (CDIDEngine.LastServerTimeSyncClock or 0)) < 60 then
        return
    end
    CDIDEngine.ServerTimeSynced = true
    CDIDEngine.LastServerTimeSyncClock = nowClock
    local function doFetch()
        pcall(function()
            local net = ReplicatedStorage:FindFirstChild("NetworkContainer")
            local rFuncs = net and net:FindFirstChild("RemoteFunctions")
            local gst = rFuncs and rFuncs:FindFirstChild("GetServerTime")
            if gst and gst:IsA("RemoteFunction") then
                local st = gst:InvokeServer()
                if tonumber(st) and tonumber(st) > 1700000000 then
                    CDIDEngine.ServerTimeOffset = tonumber(st) - os.time()
                end
            end
        end)
    end
    if not CDIDEngine.ServerTimeOffset then
        -- First sync runs inline once so CDID server time is exact before first Limited/Upcoming scan
        doFetch()
        CDIDEngine.ServerTimeOffset = CDIDEngine.ServerTimeOffset or 0
    else
        task.spawn(doFetch)
    end
end

local function getServerTimeNow()
    refreshServerTimeOffset(false)
    return os.time() + (CDIDEngine.ServerTimeOffset or 0)
