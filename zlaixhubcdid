        curOpts = newOpts or {}
        if selectVal then curVal = selectVal elseif #curOpts > 0 then
            local keep = false
            for _, o in ipairs(curOpts) do if o == curVal then keep = true break end end
            if not keep then curVal = curOpts[1] end
